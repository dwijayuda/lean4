-- PSCV0-INSTANCE-01: braced instance fields are native Lean records.
class AnonymousBox where {
  number: Nat
}
instance : AnonymousBox where { number := 23 }

class NamedBox where {
  number: Nat
}
instance chosen : NamedBox where { number := 29 }

theorem anonymousBoxNumber:
    (inferInstance : AnonymousBox).number = 23 := by { rfl }
theorem namedBoxNumber: chosen.number = 29 := by { rfl }

-- Parametric class instances reuse Lean's ordered binder and instance search.
class DefaultBox(α: Type) where {
  fallback: α
}
instance {α: Type}[Inhabited α] : DefaultBox(α) where {
  fallback := default
}

class IdentityBox(α: Type) where {
  identity: α → α
}
instance selected {α: Type} : IdentityBox(α) where {
  identity := fun x => x
}

theorem defaultBoxNat :
    (inferInstance : DefaultBox(Nat)).fallback = 0 := by { rfl }
theorem identityBoxNat :
    (selected : IdentityBox(Nat)).identity(4) = 4 := by { rfl }
