-- PSCV0-DO-IF-01: selected braced monadic if/if-let statements.
function choose(flag: Bool): Id Nat := do {
  if (flag) {
    return 42
  } else {
    return 0
  }
}

function chooseOption(x: Option Nat): Id Nat := do {
  if let .some n := x {
    return n
  } else {
    return 0
  }
}

function optionalNoElse(flag: Bool): Id Nat := do {
  if (flag) {
    let ignored ← pure(17)
  }
  return 5
}

theorem chooseTrue: choose(true) = 42 := by { rfl }
theorem chooseFalse: choose(false) = 0 := by { rfl }
theorem optionSome: chooseOption(.some(7)) = 7 := by { rfl }
theorem optionNone: chooseOption(.none) = 0 := by { rfl }
theorem optionalTrue: optionalNoElse(true) = 5 := by { rfl }
theorem optionalFalse: optionalNoElse(false) = 5 := by { rfl }
