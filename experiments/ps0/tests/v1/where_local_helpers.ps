/-! Braced where helpers retain native local recursion, captured scopes and mixed telescopes. -/
function add(x: Nat, y: Nat): Nat := x + y
structure LocalPoint where
  x : Nat
  y : Nat

function defaultHelper(n: Nat): Nat := helper(n)
where {
  def helper(x: Nat, y: Nat := add(1, 2)): Nat := add(x, y)
}

function capturedHelper(n: Nat): Nat := helper(1)
where {
  /-- Preserve local helper documentation and its permitted attribute. -/
  @[inline] def helper(x: Nat): Nat := add(n, x)
}

function equationHelper(n: Nat): Nat := helper(0, n, 0)
where {
  def helper(offset: Nat, value: Nat): Nat → Nat
    | 0 => add(offset, value)
    | Nat.succ k => helper(offset, value, k)
}

function recordHelper(n: Nat): Nat := helper(n).x
where {
  def helper(k: Nat): LocalPoint where { x := k; y := 0 }
}

function forwardHelper(n: Nat): Nat := first(n)
where {
  def first(x: Nat): Nat := second(x)
  def second(x: Nat): Nat := add(x, 1)
}

function wrappedHelper(n: Nat): Nat := helper(n)
where {
  def helper(x: Nat): Nat := { add(x, 1) }
}

function nativeWhereHelper(n: Nat): Nat := helper(n)
where
  helper(x: Nat, y: Nat := add(1, 2)): Nat := add(x, y)

function namedProof(n: Nat): Nat := ?value
where {
  finally { exact(add(n, 1)) }
}

function defaultProof(n: Nat): Nat := ?value
where {
  finally { exact(add(n, 2)) }
}

function helperProof(n: Nat): Nat := helper(n) + ?value
where {
  def helper(x: Nat): Nat := add(x, 1)
  finally { exact(2) }
}

function nativeProof(n: Nat): Nat := ?value
where
finally
  exact(add(n, 3))

example : namedProof(4) = 5 := by decide
example : defaultProof(4) = 6 := by decide
example : helperProof(4) = 7 := by decide
example : nativeProof(4) = 7 := by decide

def main : IO Unit :=
  do
    let a := defaultHelper(4)
    let b := capturedHelper(4)
    let c := equationHelper(4)
    let d := recordHelper(4)
    let e := forwardHelper(4)
    let f := wrappedHelper(4)
    let g := nativeWhereHelper(4)
    let h := namedProof(4)
    let i := defaultProof(4)
    let j := helperProof(4)
    let k := nativeProof(4)
    IO.println s!"PS0_WHERE_LOCAL:{a}:{b}:{c}:{d}:{e}"
    IO.println s!"PS0_WHERE_PROOF:{f}:{g}:{h}:{i}:{j}:{k}"
