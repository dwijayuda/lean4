module
prelude
public import Init
public meta import Init
public meta import Lean
public import PS0.Syntax
public meta section

/-! Pinned declaration operand adapters; Lean keeps modifier, binder and declaration semantics. -/

open Lean Lean.Parser.Command Lean.Parser.Term
open PS0.Binders
namespace PS0.StandardAdapters

syntax (name := psDataTerm) psTerm : psDataOperand
syntax (name := psDataTactic) psTactic : psDataTacticOperand
syntax (name := psDataCommaBinder) PS0.Binders.psCommaBinder : psDataBinder
syntax (name := psDataNativeBinder) PS0.DoLayout.dataNativeBinder : psDataBinder

scoped syntax (name := ps0StandardData) (priority := 20000)
  PS0.DoLayout.dataCommand : command

private partial def dataSameShape (left right : Syntax) : Bool :=
  match left, right with
  | .missing, .missing => true
  | .atom _ a, .atom _ b => a == b
  | .ident _ _ a _, .ident _ _ b _ => a == b
  | .node _ k xs, .node _ j ys =>
    k == j && xs.size == ys.size && (xs.zip ys).all((fun (a, b) => dataSameShape a b))
  | _, _ => false

private partial function isDataBinder(source : Syntax) : Bool :=
  source.isOfKind ``psDataNativeBinder || source.isOfKind ``psDataCommaBinder ||
    (source.isOfKind choiceKind && !source.getArgs.isEmpty && source.getArgs.all isDataBinder)

mutual
private partial function lowerDataOperands(source : Syntax) : MacroM Syntax := withRef(source, do
  if source.isOfKind ``psDataTerm then return ← PS0.Syntax.lower(`psTerm, source[0])
  if source.isOfKind ``psDataTactic then return ← PS0.Syntax.lower(`psTactic, source[0])
  let mut children := #[]
  for child in source.getArgs do
    if isDataBinder child then children := children ++ (← lowerDataBinder child)
    else children := children.push((← lowerDataOperands child))
  return source.setArgs children)

private partial function lowerDataBinder(source : Syntax) : MacroM((Array Syntax)) := withRef(source, do
  if source.isOfKind ``psDataNativeBinder then return #[← lowerDataOperands(source[0])]
  if source.isOfKind ``psDataCommaBinder then return ← PS0.Binders.lowerOne(source[0])
  unless source.isOfKind choiceKind && !source.getArgs.isEmpty do
    Macro.throwError "PS0V1-DATA-BINDER: unexpected native/comma binder role"
  let branches := source.getArgs.filter((·.isOfKind(``psDataNativeBinder))) ++
    source.getArgs.filter((fun branch => !branch.isOfKind ``psDataNativeBinder))
  let mut result? : Option((Array Syntax)) := none
  for branch in branches do
    let candidate ← lowerDataBinder branch
    if let some previous := result? then
      unless previous.size == candidate.size &&
          (previous.zip candidate).all((fun (a, b) => dataSameShape a b)) do
        Macro.throwError "PS0V1-BINDER-AMBIGUITY: different successful data binder partitions"
    else result? := some candidate
  return result?.getD #[])
end

@[macro ps0StandardData] const lowerData : Macro := fun source => withRef(source, do
  let native := source[0]
  unless native.isOfKind ``Lean.Parser.Command.declaration && native.getArgs.size == 2 &&
      #[``Lean.Parser.Command.«inductive», ``Lean.Parser.Command.«coinductive»,
        ``Lean.Parser.Command.classInductive, ``Lean.Parser.Command.«structure»].contains(native[1].getKind) do
    Macro.throwError "PS0V1-DATA: unexpected native declaration roles"
  lowerDataOperands native)

scoped syntax (name := ps0StandardInitialize) (priority := 20000)
  PS0.DoLayout.initializeCommand : command

@[macro ps0StandardInitialize] const lowerInitialize : Macro := fun source => withRef(source, do
  let native := source[0]
  unless native.isOfKind ``Lean.Parser.Command.«initialize» && native.getArgs.size == 4 &&
      (native[2].getArgs.isEmpty || native[2].getArgs.size == 3) do
    Macro.throwError "PS0V1-INITIALIZE: unexpected native named/type/sequence roles"
  let native ← if native[2].getArgs.isEmpty then pure native else do
    let typeSpec := native[2][1]
    unless typeSpec.isOfKind ``Lean.Parser.Term.typeSpec && typeSpec.getArgs.size == 2 do
      Macro.throwError "PS0V1-INITIALIZE: unexpected native result type"
    let typeSpec := typeSpec.setArg(1, (← PS0.Syntax.lower(`psTerm, typeSpec[1])))
    pure <| native.setArg(2, (native[2].setArg(1, typeSpec)))
  return native.setArg(3, (← PS0.Syntax.lowerNativeDoSequence(native[3]))))

private function nativeTerm(body : TSyntax `psTerm) : MacroM((TSyntax `term)) := do
  return ⟨← PS0.Syntax.lower `psTerm body.raw⟩

scoped syntax (name := ps0StandardCheck) (priority := 20000) "#check " psTerm : command

@[macro ps0StandardCheck] const lowerCheck : Macro := fun stx => do
  let native ← PS0.Syntax.lower `psTerm stx[1]
  return Syntax.node stx.getHeadInfo ``Lean.Parser.Command.check #[stx[0], native]

declare_syntax_cat psDeclTail
declare_syntax_cat psWhereClause
declare_syntax_cat psWhereLocalValue
declare_syntax_cat psWhereLocalDecl
declare_syntax_cat psWhereFinally
declare_syntax_cat psWhereFinallySection

@[run_parser_attribute_hooks] const nativeDeclTail : Lean.Parser.Parser :=
  -- Empty tails must also be tried when no hint keyword is the next token.
  Lean.Parser.withoutInfo((Lean.Parser.Termination.suffix >>
    Lean.Parser.optional((Lean.Parser.categoryParser `psWhereClause 0))))
syntax (name := ps0DeclTail) nativeDeclTail : psDeclTail

declare_syntax_cat psDeclValue
declare_syntax_cat psContractClause
declare_syntax_cat psDefType
declare_syntax_cat psDefDeriving
syntax (name := ps0DefDeriving) Lean.Parser.Command.optDefDeriving : psDefDeriving
syntax (name := ps0DefType) PS0.DoLayout.contractType : psDefType

private function withDeriving(declaration : Syntax, derivation : Option((TSyntax `psDefDeriving))) : Syntax :=
  match derivation with
  | none => declaration
  | some value => declaration.setArg(4, value.raw[0])

@[run_parser_attribute_hooks] const nativePSMatchAlts : Lean.Parser.Parser :=
  Lean.Parser.Term.matchAlts((Lean.Parser.categoryParser `psTerm 0))

syntax (name := ps0DeclSimple) ":=" psTerm (psDeclTail)? : psDeclValue
syntax (name := ps0DeclEqns) nativePSMatchAlts (psDeclTail)? : psDeclValue

declare_syntax_cat psStructFieldValue
declare_syntax_cat psStructField

syntax (name := ps0StructFieldDef) ":=" ("private")? psTerm : psStructFieldValue
syntax (name := ps0StructFieldEqns) ("private")? nativePSMatchAlts : psStructFieldValue

@[run_parser_attribute_hooks] const nativePSStructFieldBinders : Lean.Parser.Parser :=
  Lean.Parser.many((Lean.Parser.checkColGt >> Lean.Parser.ppSpace >>
    Lean.Parser.categoryParser `psDeclBinder 0))

syntax (name := ps0StructField) Lean.Parser.Term.structInstLVal
  (nativePSStructFieldBinders (":" psTerm)? psStructFieldValue)? : psStructField

@[run_parser_attribute_hooks] const nativePSStructFields : Lean.Parser.Parser :=
  Lean.Parser.Term.structInstFields(
    (Lean.Parser.sepByIndent( (Lean.Parser.categoryParser `psStructField 0), "; ", allowTrailingSep := true)))

syntax (name := ps0DeclWhere) "where" nativePSStructFields
  (psWhereClause)? : psDeclValue

syntax (name := ps0ContractGiven) Lean.Parser.Command.givenClause : psContractClause
syntax (name := ps0ContractRequires) Lean.Parser.Command.requiresClause : psContractClause
syntax (name := ps0ContractEnsures) Lean.Parser.Command.ensuresClause : psContractClause
syntax (name := ps0ContractValue) (psContractClause)+
  ":=" psTerm (psDeclTail)? : psDeclValue

syntax (name := psWhereLocalSimple) ":=" psTerm : psWhereLocalValue
syntax (name := psWhereLocalEquations) nativePSMatchAlts : psWhereLocalValue
syntax (name := psWhereLocalRecord) "where" "{" nativePSStructFields "}" : psWhereLocalValue
syntax (name := psWhereLocalDefinition) (Lean.Parser.Command.docComment)?
  (Lean.Parser.Term.attributes)? "def" PS0.DoLayout.localLhs psWhereLocalValue
  Lean.Parser.Termination.suffix : psWhereLocalDecl

@[run_parser_attribute_hooks] const nativePSWhereLocals : Lean.Parser.Parser :=
  Lean.Parser.sepByIndent( (Lean.Parser.categoryParser `psWhereLocalDecl 0), "; ",
    allowTrailingSep := true)

@[run_parser_attribute_hooks] const nativePSWhereDefaultTactics : Lean.Parser.Parser :=
  Lean.Parser.node ``Lean.Parser.Tactic.tacticSeq <|
    Lean.Parser.node ``Lean.Parser.Tactic.tacticSeq1Indented <|
      Lean.Parser.sepByIndent( (Lean.Parser.categoryParser `psTactic 0), "; ", allowTrailingSep := true)

@[run_parser_attribute_hooks] const nativePSWhereTacticBlock : Lean.Parser.Parser :=
  Lean.Parser.node ``Lean.Parser.Tactic.tacticSeq <|
    Lean.Parser.node ``Lean.Parser.Tactic.tacticSeqBracketed <|
      "{" >> Lean.Parser.sepByIndent( (Lean.Parser.categoryParser `psTactic 0), "; ",
        allowTrailingSep := true) >> "}"

syntax (name := psWhereFinallySection) "|" ident Lean.Parser.darrow
  nativePSWhereTacticBlock : psWhereFinallySection
syntax (name := psWhereFinallyBraced) "finally" "{" nativePSWhereDefaultTactics
  psWhereFinallySection* "}" : psWhereFinally
syntax (name := psWhereFinallyNative) (priority := high) PS0.DoLayout.whereFinally : psWhereFinally

@[run_parser_attribute_hooks] const nativePSWhereDecls : Lean.Parser.Parser :=
  Lean.Parser.leadingNode ``Lean.Parser.Term.whereDecls 0 <|
    Lean.Parser.ppDedent Lean.Parser.ppLine >> "where" >>
      Lean.Parser.sepByIndent( (Lean.Parser.ppGroup PS0.DoLayout.recursiveDeclaration), "; ",
        allowTrailingSep := true) >>
      Lean.Parser.optional((Lean.Parser.categoryParser `psWhereFinally 0))

@[run_parser_attribute_hooks] const finallyAfterHelpers : Lean.Parser.Parser :=
  Lean.Parser.withFn((fun parse ctx state =>
    let previous := state.stxStack.back
    if previous.getArgs.isEmpty || previous.getArgs.back!.getAtomVal == ";" ||
        Lean.Parser.checkTailLinebreak previous then parse ctx state
    else state.mkError "PS0V1-LOCAL-TAIL: enclosing finally requires a helper separator"),
    (Lean.Parser.categoryParser `psWhereFinally 0))

syntax (name := psWhereNative) nativePSWhereDecls : psWhereClause
syntax (name := psWhereBraced) "where" "{" nativePSWhereLocals
  (finallyAfterHelpers)? "}" : psWhereClause

private function lowerAlts(alts : Syntax) : MacroM Syntax := do
  let lowered ← alts[0].getArgs.mapM(fun alt => do
    unless alt.isOfKind ``Lean.Parser.Term.matchAlt && alt.getArgs.size == 4 do
      Macro.throwError "PS0V1-DECL-EQUATIONS: unexpected native alternative shape"
    return alt.setArg(3, (← PS0.Syntax.lower(`psTerm, alt[3]))))
  return alts.setArg(0, (alts[0].setArgs(lowered)))

private function lowerField(field : Syntax) : MacroM Syntax := do
  let optionalBody := field[1]
  if optionalBody.getArgs.isEmpty then
    return mkNode ``Lean.Parser.Term.structInstField #[field[0], optionalBody]
  let binders ← PS0.Binders.lowerTelescope((optionalBody[0].getArgs.map((⟨·⟩ : Syntax → TSyntax `psDeclBinder))))
  let ty := optionalBody[1]
  let ty ← if ty.getArgs.isEmpty then pure ty else do
    pure <| mkNullNode(#[mkNode(``Lean.Parser.Term.typeSpec,
      #[ty[0], ← PS0.Syntax.lower(`psTerm, ty[1])])])
  let value := optionalBody[2]
  let value : Syntax ← if value.isOfKind ``ps0StructFieldDef then do
    pure <| mkNode(``Lean.Parser.Term.structInstFieldDef,
      #[value[0], value[1], ← PS0.Syntax.lower(`psTerm, value[2])])
    else if value.isOfKind ``ps0StructFieldEqns then do
      pure <| mkNode(``Lean.Parser.Term.structInstFieldEqns, #[value[0], ← lowerAlts(value[1])])
    else Macro.throwError "PS0V1-STRUCT-FIELD: unsupported field declaration value"
  return mkNode ``Lean.Parser.Term.structInstField
    #[field[0], mkNullNode #[mkNullNode binders, ty, value]]

private function sourceOrigin(source : Syntax) : SourceInfo :=
  match source.getRange? with
  | some span => .synthetic span.start span.stop false
  | none => .none

private def lowerFields (source : Syntax) (asRecord := false) : MacroM Syntax := do
  let fields ← source[0].getArgs.mapM(fun field => do
    if field.isOfKind ``ps0StructField then return ← lowerField field
    if asRecord && field.isAtom && field.getAtomVal == ";" then
      return .atom((sourceOrigin field), ",")
    return field)
  return source.setArg(0, (source[0].setArgs(fields)))

private function lowerWhereTactics(source : Syntax) : MacroM Syntax := do
  unless source.isOfKind ``Lean.Parser.Tactic.tacticSeq && source.getArgs.size == 1 do
    Macro.throwError "PS0V1-WHERE-FINALLY: unexpected native tactic sequence"
  let inner := source[0]
  let index ← if inner.isOfKind ``Lean.Parser.Tactic.tacticSeqBracketed && inner.getArgs.size == 3 then
      pure 1
    else if inner.isOfKind ``Lean.Parser.Tactic.tacticSeq1Indented && inner.getArgs.size == 1 then
      pure 0
    else Macro.throwError "PS0V1-WHERE-FINALLY: unexpected native tactic layout"
  let items ← inner[index].getArgs.mapM(fun item => do
    if item.isAtom || item.isMissing || item.isOfKind nullKind then return item
    return ← PS0.Syntax.lower `psTactic item)
  return source.setArg(0, (inner.setArg(index, (inner[index].setArgs(items)))))

private function lowerFinally(source : Syntax) : MacroM Syntax := do
  if source.isOfKind ``psWhereFinallyBraced then
    unless source.getArgs.size == 5 do Macro.throwError "PS0V1-WHERE-FINALLY: invalid braced tail"
    let sections ← source[3].getArgs.mapM(fun proofSection => do
      unless proofSection.isOfKind ``psWhereFinallySection && proofSection.getArgs.size == 4 do
        Macro.throwError "PS0V1-WHERE-FINALLY: invalid subsection"
      return .node((sourceOrigin proofSection), ``Lean.Parser.Term.whereFinallySubsection,
        #[proofSection[0], proofSection[1], proofSection[2], ← lowerWhereTactics(proofSection[3])]))
    return .node((sourceOrigin source), ``Lean.Parser.Term.whereFinally,
      #[source[0], mkNullNode(#[← lowerWhereTactics(source[2])]), mkNullNode sections])
  unless source.isOfKind ``psWhereFinallyNative && source.getArgs.size == 1 do
    Macro.throwError "PS0V1-WHERE-FINALLY: unsupported tail"
  let native := source[0]
  unless native.isOfKind ``Lean.Parser.Term.whereFinally && native.getArgs.size == 3 do
    Macro.throwError "PS0V1-WHERE-FINALLY: unexpected native tail"
  let default ← if native[1].getArgs.isEmpty then pure(native[1]) else
    pure <| native[1].setArg(0, (← lowerWhereTactics(native[1][0])))
  let sections ← native[2].getArgs.mapM(fun proofSection => do
    unless proofSection.isOfKind ``Lean.Parser.Term.whereFinallySubsection && proofSection.getArgs.size == 4 do
      Macro.throwError "PS0V1-WHERE-FINALLY: unexpected native subsection"
    return proofSection.setArg(3, (← lowerWhereTactics(proofSection[3]))))
  return (native.setArg 1 default).setArg(2, (native[2].setArgs(sections)))

private function lowerOptionalFinally(source : Syntax) : MacroM Syntax := do
  if source.getArgs.isEmpty then return source
  return source.setArg(0, (← lowerFinally(source[0])))

private function lowerWhereLocal(source : Syntax) : MacroM Syntax := withRef(source, do
  unless source.isOfKind ``psWhereLocalDefinition && source.getArgs.size == 8 do
    Macro.throwError "PS0V1-WHERE-LOCAL: unexpected helper declaration"
  unless source[3].isOfKind(``Lean.Parser.Term.letId) && source[3].getArgs.size == 1 &&
      source[3][0].isIdent do
    Macro.throwError "PS0V1-WHERE-LOCAL: a braced def helper requires a name"
  let binders ← PS0.Syntax.lowerLocalTelescope(source[4].getArgs)
  let binders := PS0.Syntax.retainLocalGroup(source[4], binders)
  let ty ← PS0.Syntax.lowerNativeOptionalType(source[5])
  let value := source[6]
  let declaration : Syntax ← if value.isOfKind ``psWhereLocalSimple && value.getArgs.size == 2 then do
      pure <| .node((sourceOrigin source), ``Lean.Parser.Term.letIdDecl,
        #[source[3], binders, ty, value[0], ← PS0.Syntax.lowerBodyValue(value[1])])
    else if value.isOfKind ``psWhereLocalEquations && value.getArgs.size == 1 then do
      pure <| .node((sourceOrigin source), ``Lean.Parser.Term.letEqnsDecl,
        #[source[3], binders, ty, ← lowerAlts(value[0])])
    else if value.isOfKind ``psWhereLocalRecord && value.getArgs.size == 4 then do
      let recordValue : Syntax := .node((sourceOrigin value), ``Lean.Parser.Term.structInst,
        #[value[1], mkNullNode #[], ← lowerFields(value[2], true),
          mkNode ``Lean.Parser.Term.optEllipsis #[mkNullNode #[]], mkNullNode #[], value[3]])
      pure <| .node((sourceOrigin source), ``Lean.Parser.Term.letIdDecl,
        #[source[3], binders, ty, .atom((sourceOrigin(value[0])), ":="), recordValue])
    else Macro.throwError "PS0V1-WHERE-LOCAL: unsupported local value"
  return .node((sourceOrigin source), ``Lean.Parser.Term.letRecDecl,
    #[source[0], source[1], mkNode ``Lean.Parser.Term.letDecl #[declaration], source[7]]))

/-- Lower an owned where clause to the pinned native local-recursion/proof-tail structure. -/
function lowerWhereClause(source : Syntax) : MacroM Syntax := do
  if source.isOfKind ``psWhereBraced && source.getArgs.size == 5 then
    let helpers ← source[2].getArgs.mapM(fun helper => do
      if helper.isAtom || helper.isOfKind nullKind then return helper
      return ← lowerWhereLocal helper)
    return .node((sourceOrigin source), ``Lean.Parser.Term.whereDecls,
      #[source[0], source[2].setArgs(helpers), ← lowerOptionalFinally(source[3])])
  unless source.isOfKind ``psWhereNative && source.getArgs.size == 1 do
    Macro.throwError "PS0V1-WHERE-LOCAL: unexpected where clause"
  let native := source[0]
  unless native.isOfKind ``Lean.Parser.Term.whereDecls && native.getArgs.size == 3 do
    Macro.throwError "PS0V1-WHERE-LOCAL: unexpected native where clause"
  let declarations := mkNode ``Lean.Parser.Term.letRecDecls #[native[1]]
  let declarations ← PS0.Syntax.lowerNativeRecursiveDeclarations declarations
  return (native.setArg(1, declarations[0])).setArg(2, (← lowerOptionalFinally(native[2])))

private function lowerOptionalWhere(source : Syntax) : MacroM Syntax := do
  if source.getArgs.isEmpty then return source
  return source.setArg(0, (← lowerWhereClause(source[0])))

private function nativeValue(source : TSyntax `psDeclValue, allowContract : Bool := false) : MacroM((TSyntax ``Lean.Parser.Command.declVal)) := do
  let value := source.raw
  if value.isOfKind ``ps0DeclWhere then
    return ⟨mkNode(``Lean.Parser.Command.whereStructInst,
      #[value[0], ← lowerFields(value[1]), ← lowerOptionalWhere(value[2])])⟩
  let tail := value.getArgs.back![0]
  let defaults ← `(Lean.Parser.Command.definition| def __ps0Value := ())
  let suffix := if tail.isMissing then defaults.raw[3][2] else tail[0]
  let whereDecls ← if tail.isMissing then pure(defaults.raw[3][3]) else lowerOptionalWhere(tail[1])
  if value.isOfKind ``ps0ContractValue then
    unless allowContract do
      Macro.throwErrorAt value "PS0V1-CONTRACT: intrinsic clauses require a def or function"
    let mut clauses := #[mkNullNode #[], mkNullNode #[], mkNullNode #[]]
    let mut next := 0
    for clause in value[0].getArgs do
      let index := if clause.isOfKind ``ps0ContractGiven then 0
        else if clause.isOfKind ``ps0ContractRequires then 1 else 2
      if index < next then
        Macro.throwErrorAt clause "PS0V1-CONTRACT-ORDER: expected given, requires, ensures in order"
      next := index + 1
      clauses := clauses.set!(index, mkNullNode #[clause[0]])
    let body := mkNode ``Lean.Parser.Command.declValSimple
      #[value[1], ← PS0.Syntax.lowerBodyValue(value[2]), suffix, whereDecls]
    return ⟨mkNode(``Lean.Parser.Command.contractDeclVal, clauses.push(body))⟩
  if value.isOfKind ``ps0DeclSimple then
    return ⟨mkNode(``Lean.Parser.Command.declValSimple,
      #[value[0], ← PS0.Syntax.lowerBodyValue(value[1]), suffix, whereDecls])⟩
  unless value.isOfKind ``ps0DeclEqns do
    Macro.throwError "PS0V1-DECL-VALUE: unsupported declaration value"
  return ⟨mkNode(``Lean.Parser.Command.declValEqns,
    #[mkNode(``Lean.Parser.Term.matchAltsWhereDecls,
      #[← lowerAlts(value[0]), suffix, whereDecls])])⟩

scoped syntax (name := ps0StandardDef) (priority := 20000)
  declModifiers "def " declId psDeclBinder* (":" psDefType)? psDeclValue (psDefDeriving)? : command
scoped syntax (name := ps0StandardAbbrev) (priority := 20000)
  declModifiers "abbrev " declId psDeclBinder* (":" psTerm)? psDeclValue : command
scoped syntax (name := ps0StandardTheorem) (priority := 20000)
  declModifiers "theorem " declId psDeclBinder* ":" psTerm psDeclValue : command
scoped syntax (name := ps0StandardExample) (priority := 20000)
  declModifiers "example " psDeclBinder* (":" psTerm)? psDeclValue : command

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardDef)
  | `(ps0StandardDef| $mods:declModifiers def $name:declId $bs:psDeclBinder* $[: $ty:psDefType]? $value:psDeclValue $[$derivation:psDefDeriving]?) => do
      let bs ← PS0.Binders.lowerTelescope bs
      let ty ← ty.mapM(fun captured => nativeTerm ⟨captured.raw[0]⟩)
      let value ← nativeValue value true
      let decl ← `(Lean.Parser.Command.definition| def $name:declId $bs:bracketedBinder* $[: $ty:term]? $value:declVal)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, withDeriving decl.raw derivation]

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardAbbrev)
  | `($mods:declModifiers abbrev $name:declId $bs:psDeclBinder* $[: $ty:psTerm]? $value:psDeclValue) => do
      let bs ← PS0.Binders.lowerTelescope bs
      let ty ← ty.mapM nativeTerm
      let value ← nativeValue value
      let decl ← `(Lean.Parser.Command.abbrev| abbrev $name:declId $bs:bracketedBinder* $[: $ty:term]? $value:declVal)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, decl.raw]

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardTheorem)
  | `($mods:declModifiers theorem $name:declId $bs:psDeclBinder* : $ty:psTerm $value:psDeclValue) => do
      let bs ← PS0.Binders.lowerTelescope bs
      let ty ← nativeTerm ty
      let value ← nativeValue value
      let decl ← `(Lean.Parser.Command.theorem| theorem $name:declId $bs:bracketedBinder* : $ty:term $value:declVal)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, decl.raw]

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardExample)
  | `($mods:declModifiers example $bs:psDeclBinder* $[: $ty:psTerm]? $value:psDeclValue) => do
      let bs ← PS0.Binders.lowerTelescope bs
      let ty ← ty.mapM nativeTerm
      let value ← nativeValue value
      let decl ← `(Lean.Parser.Command.example| example $bs:bracketedBinder* $[: $ty:term]? $value:declVal)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, decl.raw]

scoped syntax (name := ps0StandardFunction) (priority := 20000)
  declModifiers "function " declId psDeclBinder+ (":" psDefType)? psDeclValue (psDefDeriving)? : command

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardFunction)
  | `(ps0StandardFunction| $mods:declModifiers function $name:declId $bs:psDeclBinder* $[: $ty:psDefType]? $value:psDeclValue $[$derivation:psDefDeriving]?) => do
      let bs ← PS0.Binders.lowerTelescope bs true
      let ty ← ty.mapM(fun captured => nativeTerm ⟨captured.raw[0]⟩)
      let value ← nativeValue value true
      let decl ← `(Lean.Parser.Command.definition| def $name:declId $bs:bracketedBinder* $[: $ty:term]? $value:declVal)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, withDeriving decl.raw derivation]

scoped syntax (name := ps0StandardOpaque) (priority := 20000)
  declModifiers "opaque " declId psDeclBinder* ":" psTerm (":=" psTerm)? : command
scoped syntax (name := ps0StandardAxiom) (priority := 20000)
  declModifiers "axiom " declId psDeclBinder* ":" psTerm : command
scoped syntax (name := ps0StandardConst) (priority := 20000)
  declModifiers "const " declId (":" psTerm)? psDeclValue (psDefDeriving)? : command
scoped syntax (name := ps0StandardInstance) (priority := 20000)
  declModifiers attrKind "instance" optNamedPrio (declId)? psDeclBinder* ":" psTerm psDeclValue : command

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardOpaque)
  | `($mods:declModifiers opaque $name:declId $bs:psDeclBinder* : $ty:psTerm $[:= $body:psTerm]?) => do
      let bs ← PS0.Binders.lowerTelescope bs
      let ty ← nativeTerm ty
      let body ← body.mapM nativeTerm
      let decl ← `(Lean.Parser.Command.opaque| opaque $name:declId $bs:bracketedBinder* : $ty:term $[:= $body:term]?)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, decl.raw]

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardAxiom)
  | `($mods:declModifiers axiom $name:declId $bs:psDeclBinder* : $ty:psTerm) => do
      let bs ← PS0.Binders.lowerTelescope bs
      let ty ← nativeTerm ty
      let decl ← `(Lean.Parser.Command.axiom| axiom $name:declId $bs:bracketedBinder* : $ty:term)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, decl.raw]

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardConst)
  | `($mods:declModifiers const $name:declId $[: $ty:psTerm]? $value:psDeclValue $[$derivation:psDefDeriving]?) => do
      let ty ← ty.mapM nativeTerm
      let value ← nativeValue value
      let decl ← `(Lean.Parser.Command.definition| def $name:declId $[: $ty:term]? $value:declVal)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, withDeriving decl.raw derivation]

open scoped PS0.StandardAdapters in
macro_rules (kind := ps0StandardInstance)
  | `($mods:declModifiers $kind:attrKind instance $[$prio:namedPrio]? $[$name:declId]? $bs:psDeclBinder* : $ty:psTerm $value:psDeclValue) => do
      let bs ← PS0.Binders.lowerTelescope bs
      let ty ← nativeTerm ty
      let value ← nativeValue value
      let decl ← `(Lean.Parser.Command.instance| $kind:attrKind instance $[$prio:namedPrio]? $[$name:declId]? $bs:bracketedBinder* : $ty:term $value:declVal)
      return mkNode ``Lean.Parser.Command.declaration #[mods.raw, decl.raw]

end PS0.StandardAdapters
