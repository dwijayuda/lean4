module
prelude
public import Init
public meta import Init
public import Lean
public import PS0.OperatorDescriptors
public section

/-! Observe the original command stream supplied by Lean's native module-linter hook. -/

open Lean Lean.Elab.Command
namespace PS0.SourceCensus

register_builtin_option ps0.sourceCensusPath : String := {
  defValue := ""
  descr := "write actual native frontend source-command census evidence"
}

register_builtin_option ps0.loweredCensus : Bool := {
  defValue := false
  descr := "retain diagnostic native syntax after the PS declaration adapter"
}

private function sourceRange(source : Syntax) : Json :=
  match source.getRange? with
  | none => .null
  | some r => Json.mkObj [("start", toJson r.start.byteIdx), ("end", toJson r.stop.byteIdx)]

private partial function signatureSyntax(operators : Array Name, source : Syntax) : Json :=
  Json.mkObj([
    ("kind", toJson source.getKind.toString), ("range", sourceRange source),
    ("ident", if source.isIdent then toJson source.getId.toString else .null),
    ("atom", if source.isAtom then toJson source.getAtomVal else .null),
    ("nativeBinaryOperator", toJson((operators.contains source.getKind))),
    ("args", toJson((source.getArgs.map((signatureSyntax operators)))))])

private function application(value : Syntax) : Json := Id.run(do
  unless value.isOfKind ``Lean.Parser.Term.app do return .null
  return Json.mkObj([
    ("range", sourceRange value), ("functionRange", sourceRange(value[0])),
    ("arguments", toJson((value[1].getArgs.map(fun arg => Json.mkObj [
      ("kind", toJson arg.getKind.toString), ("range", sourceRange arg)]))))]))

private function valueApplication(native : Syntax) : Json := Id.run(do
  unless native.isOfKind ``Lean.Parser.Command.definition &&
      native[3].isOfKind(``Lean.Parser.Command.declValSimple) do return .null
  return application(native[3][1]))

private function lambdaBodyApplications(native : Syntax) : Array Json := Id.run(do
  unless native.isOfKind ``Lean.Parser.Command.definition &&
      native[3].isOfKind(``Lean.Parser.Command.declValSimple) do return #[]
  let value := native[3][1]
  unless value.isOfKind ``Lean.Parser.Term.app do return #[]
  let mut result := #[]
  for arg in value[1].getArgs do
    let body := if arg.isOfKind ``Lean.Parser.Term.paren then arg[1] else arg
    if body.isOfKind ``Lean.Parser.Term.fun && body[1].isOfKind(``Lean.Parser.Term.basicFun) then
      match application(body[1][3]) with
      | .null => pure(())
      | call => result := result.push call
  return result)

private partial function ownedOperators(source : Syntax) : Array Name := Id.run(do
  if source.isOfKind `PS0.Operators.ownedBinary then
    if source[0].isOfKind(choiceKind) then
      return source[0].getArgs.foldl((fun kinds alternative =>
        kinds ++ #[alternative.getKind] ++ ownedOperators(alternative[0]) ++ ownedOperators(alternative[2])), #[])
    return #[source[0].getKind] ++ ownedOperators(source[0][0]) ++ ownedOperators(source[0][2])
  if source.isOfKind `PS0.Operators.ownedPostfix then
    return ownedOperators(source[0][0])
  let containers := #[`null, `ps0HostAdjacentCall, `ps0HostHeadTerm, `ps0HeadCall,
    `ps0HeadEmptyCall, `ps0ParenthesizedHead, `ps0HostParens, `ps0HostBraces,
    `ps0PositionalArg, `ps0NamedArg, `ps0HostLambda]
  unless containers.contains source.getKind do return #[]
  return source.getArgs.foldl((fun kinds arg => kinds ++ ownedOperators arg), #[]))

private partial function ownedIndices(operators : Array Name, source : Syntax) : Array Json := Id.run(do
  if source.isOfKind `PS0.Operators.ownedPostfix then
    let native := source[0]
    let kinds := #[`«term__[_]», `«term__[_]'_», `«term__[_]_?», `«term__[_]_!»]
    if kinds.contains native.getKind then
      let index := if native.getArgs.size == 7 then 3 else 2
      let proof := if native.isOfKind `«term__[_]'_» then native[4] else Syntax.missing
      return #[Json.mkObj([
        ("kind", toJson native.getKind.toString), ("range", sourceRange native),
        ("syntax", signatureSyntax operators native),
        ("subjectKind", toJson(native[0].getKind.toString)),
        ("indexKind", toJson(native[index].getKind.toString)),
        ("proofKind", toJson proof.getKind.toString)])] ++
        ownedIndices(operators, native[0]) ++ ownedIndices(operators, native[index]) ++
        ownedIndices operators proof
    if native.isOfKind ``Lean.Parser.Term.pipeProj then
      return ownedIndices(operators, native[0]) ++ ownedIndices(operators, native[4])
    return ownedIndices(operators, native[0])
  if source.isOfKind `PS0.Operators.ownedBinary then
    return source[0].getArgs.foldl((fun found child => found ++ ownedIndices operators child), #[])
  let containers := #[`null, `ps0HostAdjacentCall, `ps0HostHeadTerm, `ps0HeadCall,
    `ps0HeadEmptyCall, `ps0ParenthesizedHead, `ps0HostParens, `ps0HostBraces,
    `ps0PositionalArg, `ps0NamedArg, `ps0HostLambda]
  unless containers.contains source.getKind do return #[]
  return source.getArgs.foldl((fun found child => found ++ ownedIndices operators child), #[]))

private partial function ownedDoNodes(source : Syntax) : Array Syntax := Id.run(do
  if source.isOfKind `ps0HostDo then return ownedDoNodes(source[1])
  if source.isOfKind `ps0NativeLayoutDoSeq then return ownedDoNodes(source[0])
  if source.isOfKind ``Lean.Parser.Term.doSeqItem then return ownedDoNodes(source[0])
  if source.isOfKind ``Lean.Parser.Term.doSeqIndent || source.isOfKind ``Lean.Parser.Term.doSeqBracketed then
    let index := if source.isOfKind ``Lean.Parser.Term.doSeqIndent then 0 else 1
    return source[index].getArgs.foldl((fun nodes item => nodes ++ ownedDoNodes item), #[])
  if source.isOfKind nullKind || source.isOfKind `group then
    return source.getArgs.foldl((fun nodes item => nodes ++ ownedDoNodes item), #[])
  if source.isOfKind ``Lean.Parser.Term.matchAlts then
    return source[0].getArgs.foldl((fun nodes alternative => nodes ++ ownedDoNodes(alternative[3])), #[])
  if source.isOfKind ``Lean.Parser.Term.doCatch then return ownedDoNodes(source[4])
  if source.isOfKind ``Lean.Parser.Term.doCatchMatch || source.isOfKind ``Lean.Parser.Term.doFinally then
    return ownedDoNodes(source[1])
  let known := #[``Lean.Parser.Term.doLet, ``Lean.Parser.Term.doLetArrow,
    ``Lean.Parser.Term.doReassign, ``Lean.Parser.Term.doReturn, ``Lean.Parser.Term.doExpr,
    ``Lean.Parser.Term.doNested, ``Lean.Parser.Term.doUnless, ``Lean.Parser.Term.doLetRec,
    ``Lean.Parser.Term.doIf, ``Lean.Parser.Term.doMatch, ``Lean.Parser.Term.doHave,
    ``Lean.Parser.Term.doFor, ``Lean.Parser.Term.doTry, ``Lean.Parser.Term.doWhile,
    ``Lean.Parser.Term.doRepeatUntil]
  unless known.contains source.getKind do return #[]
  let mut nodes := #[source]
  if source.isOfKind ``Lean.Parser.Term.doIf then
    nodes := nodes ++ ownedDoNodes(source[3]) ++ ownedDoNodes(source[4]) ++ ownedDoNodes(source[5])
  else if source.isOfKind ``Lean.Parser.Term.doMatch then
    nodes := nodes ++ ownedDoNodes(source[6])
  else if source.isOfKind ``Lean.Parser.Term.doFor || source.isOfKind ``Lean.Parser.Term.doWhile then
    nodes := nodes ++ ownedDoNodes(source[5])
  else if source.isOfKind ``Lean.Parser.Term.doRepeatUntil then
    nodes := nodes ++ ownedDoNodes(source[3])
  else if source.isOfKind ``Lean.Parser.Term.doTry then
    nodes := nodes ++ ownedDoNodes(source[1]) ++ ownedDoNodes(source[2]) ++ ownedDoNodes(source[3])
  else if source.isOfKind ``Lean.Parser.Term.doHave then
    let declaration := source[2][0]
    if declaration.isOfKind ``Lean.Parser.Term.letIdDecl then
      nodes := nodes ++ ownedDoNodes(declaration[4])
  else if source.isOfKind ``Lean.Parser.Term.doUnless then
    nodes := nodes ++ ownedDoNodes(source[3])
  else if source.isOfKind ``Lean.Parser.Term.doNested then
    nodes := nodes ++ ownedDoNodes(source[1])
  else if source.isOfKind ``Lean.Parser.Term.doExpr then
    nodes := nodes ++ ownedDoNodes(source[0])
  else if source.isOfKind ``Lean.Parser.Term.doLetArrow then
    let decl := source[3]
    if decl.isOfKind ``Lean.Parser.Term.doIdDecl || decl.isOfKind ``Lean.Parser.Term.doPatDecl then
      nodes := nodes ++ ownedDoNodes(decl[3])
    if decl.isOfKind ``Lean.Parser.Term.doPatDecl && !decl[4].getArgs.isEmpty then
      nodes := nodes ++ ownedDoNodes(decl[4][1])
      if !decl[4][2].getArgs.isEmpty then
        nodes := nodes ++ ownedDoNodes(decl[4][2][0])
  return nodes)

private function adjacentCallSpelling(env : Environment, name : Syntax) : String := Id.run(do
  let identifier := name[0]
  let .ident _ raw _ _ := identifier | return ""
  let spelling := raw.toString
  if !name[1].getArgs.isEmpty then return spelling
  let input := spelling ++ "("
  let context := Lean.Parser.mkInputContext input "<adjacent-declaration-head>"
  let state := Lean.Parser.identFn.run(context, {env, options := {}},
    (Lean.Parser.getTokenTable env), (Lean.Parser.mkParserState input))
  if state.allErrors.isEmpty && state.pos.byteIdx == spelling.utf8ByteSize then return spelling
  match identifier.getId with
  | .str ownerName component =>
      let escaped := "«" ++ component ++ "»"
      return if ownerName.isAnonymous then escaped else ownerName.toString ++ "." ++ escaped
  | _ => return spelling)

private function declaration(env : Environment, operators : Array Name, source : Syntax) : Json := Id.run(do
  let kind := source.getKind
  let mapped := #[
    `PS0.StandardAdapters.ps0StandardDef, `PS0.StandardAdapters.ps0StandardAbbrev,
    `PS0.StandardAdapters.ps0StandardTheorem, `PS0.StandardAdapters.ps0StandardOpaque,
    `PS0.StandardAdapters.ps0StandardAxiom, `PS0.StandardAdapters.ps0StandardFunction,
    `PS0.StandardAdapters.ps0StandardConst, `PS0.StandardAdapters.ps0StandardInstance,
    `PS0.StandardAdapters.ps0StandardExample]
  if mapped.contains kind then
    let isInstance := kind == `PS0.StandardAdapters.ps0StandardInstance
    let isExample := kind == `PS0.StandardAdapters.ps0StandardExample
    let name := if isExample then Syntax.missing else if isInstance then source[4][0] else source[2]
    let signature := if isExample then source[2] else if isInstance then source[5] else source[3]
    let hasTail := #[`PS0.StandardAdapters.ps0StandardDef, `PS0.StandardAdapters.ps0StandardAbbrev,
      `PS0.StandardAdapters.ps0StandardTheorem, `PS0.StandardAdapters.ps0StandardFunction,
      `PS0.StandardAdapters.ps0StandardConst, `PS0.StandardAdapters.ps0StandardInstance,
      `PS0.StandardAdapters.ps0StandardExample].contains(kind)
    let last := source.getArgs.back!
    let hasDerivingSlot := #[`PS0.StandardAdapters.ps0StandardDef,
      `PS0.StandardAdapters.ps0StandardFunction, `PS0.StandardAdapters.ps0StandardConst].contains(kind)
    let declValue := if !hasTail then Syntax.missing else
      if hasDerivingSlot then source.getArgs[source.getArgs.size - 2]! else last
    let value := if declValue.isOfKind `PS0.StandardAdapters.ps0DeclSimple then declValue[1] else Syntax.missing
    let doSequence := if value.isOfKind `ps0HostDo && value[1].isOfKind(`ps0NativeLayoutDoSeq) then
      value[1][0] else Syntax.missing
    let doElements := if doSequence.isOfKind ``Lean.Parser.Term.doSeqIndent then doSequence[0].getArgs
      else if doSequence.isOfKind ``Lean.Parser.Term.doSeqBracketed then doSequence[1].getArgs else #[]
    let ownedDoElements := ownedDoNodes doSequence
    let recursiveGroups := if value.isOfKind ``Lean.Parser.Term.letrec then #[value[1]] else
      (ownedDoElements.filter((·.isOfKind(``Lean.Parser.Term.doLetRec)))).map((·[1]))
    let recursiveValues := recursiveGroups.foldl((fun values group =>
      values ++ group[0].getSepArgs.map((fun declaration => declaration[2][0]))), #[])
    let recursiveSimpleValues := recursiveValues.filter((·.isOfKind(``Lean.Parser.Term.letIdDecl)))
    let recursiveEquationValues := recursiveValues.filter((·.isOfKind(``Lean.Parser.Term.letEqnsDecl)))
    let unlessElements := ownedDoElements.filter((·.isOfKind(``Lean.Parser.Term.doUnless)))
    let patternBindings := ownedDoElements.filter(fun item => item.isOfKind ``Lean.Parser.Term.doLetArrow &&
      item[3].isOfKind(``Lean.Parser.Term.doPatDecl))
    let tail := if hasTail then declValue.getArgs.back![0] else Syntax.missing
    let whereClause := if declValue.isOfKind `PS0.StandardAdapters.ps0DeclWhere then
        declValue[2][0]
      else tail[1][0]
    let nativeWhere := if whereClause.isOfKind `PS0.StandardAdapters.psWhereNative then
        whereClause[0]
      else Syntax.missing
    let whereHelpers := if whereClause.isOfKind `PS0.StandardAdapters.psWhereBraced then
        whereClause[2].getArgs.filter((·.isOfKind(`PS0.StandardAdapters.psWhereLocalDefinition)))
      else nativeWhere[1].getArgs.filter((·.isOfKind(``Lean.Parser.Term.letRecDecl)))
    let whereFinally := if whereClause.isOfKind `PS0.StandardAdapters.psWhereBraced then
        whereClause[3][0]
      else nativeWhere[2][0]
    let whereProofSections := if whereFinally.isOfKind `PS0.StandardAdapters.psWhereFinallyBraced then
        whereFinally[3].getArgs
      else if whereFinally.isOfKind `PS0.StandardAdapters.psWhereFinallyNative then
        whereFinally[0][2].getArgs
      else #[]
    let equationBodies := if declValue.isOfKind `PS0.StandardAdapters.ps0DeclEqns then
      declValue[0][0].getArgs.map((fun alt => alt[3].getKind.toString)) else #[]
    return Json.mkObj([
      ("mode", toJson ("mapped-ps" : String)), ("production", toJson kind.toString),
      ("sourceName", toJson((if name.isMissing then "" else name[0].getId.toString))),
      ("keywordRange", sourceRange((if isInstance then source[2] else source[1]))), ("nameRange", sourceRange name),
      ("signatureRange", sourceRange signature), ("signatureSyntax", signatureSyntax operators signature),
      ("mappedCommandSyntax", signatureSyntax operators source),
      ("nameIdentifierRange", sourceRange(name[0])),
      ("adjacentCallSpelling", toJson((adjacentCallSpelling env name))),
      ("valueRootKind", toJson value.getKind.toString),
      ("recursiveGroupCount", toJson recursiveGroups.size),
      ("recursiveDeclarationKinds", toJson((recursiveValues.map((fun item => item.getKind.toString))))),
      ("recursiveSimpleValueKinds", toJson((recursiveSimpleValues.map((fun item => item[4].getKind.toString))))),
      ("recursiveEquationValueKinds", toJson((recursiveEquationValues.foldl((fun bodies item =>
        bodies ++ item[3][0].getArgs.map((fun alternative => alternative[3].getKind.toString))), (#[] : Array String))))),
      ("recursiveTermContinuationKind", toJson((if value.isOfKind ``Lean.Parser.Term.letrec then
        value[3].getKind.toString else ""))),
      ("nativeDefDeriving", toJson((hasDerivingSlot && !last.getArgs.isEmpty &&
        !last[0][0].getArgs.isEmpty))),
      ("doSequenceKind", toJson doSequence.getKind.toString),
      ("doElementKinds", toJson((doElements.map((fun item => item[0].getKind.toString))))),
      ("ownedDoElementKinds", toJson((ownedDoElements.map((fun item => item.getKind.toString))))),
      ("doPatternBindingCount", toJson patternBindings.size),
      ("doUnlessConditionKinds", toJson((unlessElements.map((fun item => item[1].getKind.toString))))),
      ("doUnlessBlockKinds", toJson((unlessElements.map((fun item => item[3].getKind.toString))))),
      ("termUnlessConditionKind", toJson((if value.isOfKind ``Lean.Parser.Term.termUnless then
        value[1].getKind.toString else ""))),
      ("ownedValueCall", toJson((value.isOfKind `ps0HostAdjacentCall ||
        (value.isOfKind `ps0HostHeadTerm && value[0].isOfKind(`ps0HeadCall))))),
      ("ownedOperatorKinds", toJson(((ownedOperators value).map(Name.toString)))),
      ("ownedIndexedAccess", toJson((ownedIndices operators value))),
      ("declarationValueKind", toJson declValue.getKind.toString),
      ("equationBodyKinds", toJson equationBodies),
      ("whereFieldCount", toJson((if declValue.isOfKind `PS0.StandardAdapters.ps0DeclWhere then
        declValue[1][0].getSepArgs.size else 0))),
      ("nativeWhereTail", toJson((whereClause.isOfKind ``Lean.Parser.Term.whereDecls ||
        whereClause.isOfKind `PS0.StandardAdapters.psWhereNative))),
      ("whereClauseKind", toJson whereClause.getKind.toString),
      ("whereHelperCount", toJson whereHelpers.size),
      ("whereHelperNames", toJson((whereHelpers.map(fun helper =>
        (if helper.isOfKind `PS0.StandardAdapters.psWhereLocalDefinition then helper[3][0]
          else helper[2][0][0][0]).getId.toString)))),
      ("whereHelperValueKinds", toJson((whereHelpers.map(fun helper =>
        (if helper.isOfKind `PS0.StandardAdapters.psWhereLocalDefinition then helper[6]
          else helper[2][0]).getKind.toString)))),
      ("whereHelperDocCount", toJson((whereHelpers.filter((fun helper => !helper[0].getArgs.isEmpty))).size)),
      ("whereHelperAttributeCount", toJson((whereHelpers.filter((fun helper => !helper[1].getArgs.isEmpty))).size)),
      ("whereFinallyKind", toJson whereFinally.getKind.toString),
      ("whereFinallySectionNames", toJson((whereProofSections.map((fun proofSection => proofSection[1].getId.toString)))))])
  if source.isOfKind ``Lean.Parser.Command.declaration then
    let native := source[1]
    let supported := #[``Lean.Parser.Command.definition, ``Lean.Parser.Command.abbrev,
      ``Lean.Parser.Command.theorem, ``Lean.Parser.Command.opaque, ``Lean.Parser.Command.axiom,
      ``Lean.Parser.Command.instance, ``Lean.Parser.Command.example]
    if supported.contains native.getKind then
      let isInstance := native.isOfKind ``Lean.Parser.Command.instance
      let isExample := native.isOfKind ``Lean.Parser.Command.example
      let name := if isExample then Syntax.missing else if isInstance then native[3][0] else native[1]
      let signature := if isExample then native[1] else if isInstance then native[4] else native[2]
      return Json.mkObj([
        ("mode", toJson ("native-compatible" : String)),
        ("production", toJson native.getKind.toString),
        ("sourceName", toJson((if name.isMissing then "" else name[0].getId.toString))),
        ("keywordRange", sourceRange((if isInstance then native[1] else native[0]))), ("nameRange", sourceRange name),
        ("signatureRange", sourceRange signature), ("signatureSyntax", signatureSyntax operators signature),
        ("nameIdentifierRange", sourceRange(name[0])),
        ("adjacentCallSpelling", toJson((adjacentCallSpelling env name))),
        ("valueSyntax", signatureSyntax(operators, (if isExample then native[2] else if isInstance then native[5] else native[3]))),
        ("valueApplication", valueApplication native),
        ("lambdaBodyApplications", toJson((lambdaBodyApplications native)))])
  return .null)

private partial function command(env : Environment, operators : Array Name, source : Syntax) : Json :=
  let viewed := if source.isOfKind `ps0NativeCommandBridge then source[0] else source
  -- Legacy host syntax can tie with the native declaration parser in a self-source
  -- census. Keep the raw command kind and expose only a unique native declaration.
  let viewed := if viewed.isOfKind choiceKind then
    let alternatives := viewed.getArgs.filter((·.isOfKind(``Lean.Parser.Command.declaration)))
    if alternatives.size == 1 then alternatives[0]! else viewed
  else viewed
  let initialized := if viewed.isOfKind `PS0.StandardAdapters.ps0StandardInitialize then viewed[0] else viewed
  let dataRoot := if viewed.isOfKind `PS0.StandardAdapters.ps0StandardData then viewed[0] else viewed
  let dataDeclaration := if dataRoot.isOfKind ``Lean.Parser.Command.declaration &&
      dataRoot.getArgs.size == 2 &&
      #[``Lean.Parser.Command.«inductive», ``Lean.Parser.Command.«coinductive»,
        ``Lean.Parser.Command.classInductive, ``Lean.Parser.Command.«structure»].contains(dataRoot[1].getKind) then
    Json.mkObj([
      ("mode", toJson((if viewed.isOfKind `PS0.StandardAdapters.ps0StandardData then "mapped-ps" else "native-compatible"))),
      ("syntax", signatureSyntax operators dataRoot)]) else Json.null
  let initialization := if initialized.isOfKind ``Lean.Parser.Command.«initialize» &&
      initialized.getArgs.size == 4 then Json.mkObj([
    ("mode", toJson((if viewed.isOfKind `PS0.StandardAdapters.ps0StandardInitialize then
      "mapped-ps" else "native-compatible"))),
    ("syntax", signatureSyntax operators initialized)]) else Json.null
  let nested := if viewed.isOfKind ``Lean.Parser.Command.«in» then #[viewed[2]] else
    if viewed.isOfKind ``Lean.Parser.Command.«mutual» then viewed[1].getArgs else #[]
  Json.mkObj([
    ("kind", toJson source.getKind.toString), ("range", sourceRange source),
    ("headKind", toJson((if viewed.isOfKind ``Lean.Parser.Command.declaration then
      viewed[1].getKind.toString else viewed.getKind.toString))),
    ("declaration", declaration env operators viewed),
    ("initialization", initialization),
    ("dataDeclaration", dataDeclaration),
    ("nestedCommands", toJson((nested.map((command env operators)))))])

private partial function syntaxKinds(names : NameSet, source : Syntax) : NameSet :=
  source.getArgs.foldl(syntaxKinds, (names.insert source.getKind))

private partial function expandDiagnosticCommand(source : Syntax) : MacroM Syntax := do
  if source.getKind.toString.startsWith "PS0.StandardAdapters.ps0Standard" then
    return (← Macro.expandMacro? source).getD(source)
  if source.isOfKind `ps0NativeCommandBridge then
    return ← expandDiagnosticCommand(source[0])
  if source.isOfKind ``Lean.Parser.Command.«in» then
    return source.setArg(2, (← expandDiagnosticCommand(source[2])))
  if source.isOfKind ``Lean.Parser.Command.«mutual» then
    return source.setArg(1, (source[1].setArgs((← source[1].getArgs.mapM(expandDiagnosticCommand)))))
  return source

function collect(commands : Array Syntax) : CommandElabM Unit := do
  let output := (← getOptions).get(`ps0.sourceCensusPath, ("" : String))
  unless output.isEmpty do
    let context ← read
    let env ← getEnv
    -- A scoped parser may no longer be active after its namespace closes.
    -- Validate descriptors named by the captured nodes as well as active parsers.
    let names := commands.foldl syntaxKinds {}
    let operators := PS0.OperatorDescriptors.binaryKinds(env, (← getOptions)) ++
      PS0.OperatorDescriptors.binaryKindsFor(env, (← getOptions), names.toArray)
    let locals ← env.getLocalConstantInfos
    let imports := env.header.imports.map((fun (i : Import) => i.module.toString))
    let names := locals.map((fun (c : AsyncConstantInfo) => c.toConstantInfo.name.toString))
      |>.qsort (· < ·)
    let lowered ← if (← getOptions).getBool(`ps0.loweredCensus, false) then
        commands.mapM(fun source => do
          let expanded ← Lean.Elab.liftMacroM <| expandDiagnosticCommand source
          pure <| command env operators expanded)
      else pure #[]
    let data := Json.mkObj([
      ("schema", toJson ("ps0-native-source-census/1" : String)),
      ("operatorDescriptorScope", toJson ("active-and-captured-kinds/2" : String)),
      ("adjacentHeadLexicalScope", toJson ("native-environment/1" : String)),
      ("leanCommit", toJson Lean.githash), ("module", toJson((← getMainModule).toString)),
      ("file", toJson context.fileName), ("nativeSource", toJson context.fileMap.source),
      ("commands", toJson((commands.map((command env operators))))),
      ("initializerOperandScope", toJson ("native-initializer-operands/1" : String)),
      ("dataDeclarationOperandScope", toJson ("native-data-declaration-operands/1" : String)),
      ("mappedOperandSyntaxScope", toJson ("raw-command-before-native-lowering/1" : String)),
      ("loweredCommands", toJson lowered),
      ("imports", toJson imports),
      ("environmentDeclNames", toJson names),
      ("grammarMigrationComplete", toJson false)])
    IO.FS.writeFile output data.compress

builtin_initialize
  addModuleLinter { name := `PS0.SourceCensus.collect, run := collect }

end PS0.SourceCensus
