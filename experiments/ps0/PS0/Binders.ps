module
prelude
public import Init
public meta import Init
public meta import Lean
public import PS0.HostCategories
public meta section

/-! Owned telescope operands lower to pinned native binder nodes, in source order. -/

open Lean Lean.Parser.Term
namespace PS0.Binders

declare_syntax_cat psBinderParam
declare_syntax_cat psDeclBinder

const binderDefault := leading_parser " := " >> Lean.Parser.categoryParser `psTerm 0
const binderSuffix := Lean.Parser.Term.binderTactic <|> binderDefault

syntax ident ":" psTerm (binderSuffix)? : psBinderParam
syntax (name := psCommaBinder) "(" sepBy1(psBinderParam, ",", "," ppSpace, allowTrailingSep) ")" : psDeclBinder
syntax (name := psExplicitBinder) "(" Lean.Parser.Term.binderIdent+ (":" psTerm)? (binderSuffix)? ")" : psDeclBinder
syntax (name := psImplicitBinder) "{" Lean.Parser.Term.binderIdent+ (":" psTerm)? "}" : psDeclBinder
syntax (name := psStrictBinder) "⦃" Lean.Parser.Term.binderIdent+ (":" psTerm)? "⦄" : psDeclBinder
syntax (name := psAsciiStrictBinder) Lean.Parser.Term.strictImplicitLeftBracket
  Lean.Parser.Term.binderIdent+ (":" psTerm)? Lean.Parser.Term.strictImplicitRightBracket : psDeclBinder
syntax (name := psInstanceBinder) "[" Lean.Parser.Term.optIdent psTerm "]" : psDeclBinder
syntax (name := psIdentifierBinder) Lean.Parser.Term.binderIdent : psDeclBinder
syntax (name := psNullaryBinder) "(" ")" : psDeclBinder

private function origin(source : Syntax) : SourceInfo :=
  match source.getRange? with
  | some span => .synthetic span.start span.stop false
  | none => .none

private function lowerType(optionalType : Syntax) : MacroM Syntax := do
  if optionalType.getArgs.isEmpty then return optionalType
  return optionalType.setArg(1, (← PS0.Syntax.lower(`psTerm, optionalType[1])))

private function lowerSuffix(optionalSuffix : Syntax) : MacroM Syntax := do
  if optionalSuffix.getArgs.isEmpty then return optionalSuffix
  let suffix := optionalSuffix[0]
  if suffix.isOfKind ``Lean.Parser.Term.binderTactic then return optionalSuffix
  unless suffix.isOfKind ``binderDefault do Macro.throwError "PS0V1-BINDER-SUFFIX: unsupported default"
  return mkNullNode(#[.node((origin suffix), ``Lean.Parser.Term.binderDefault,
    #[suffix[0], ← PS0.Syntax.lower(`psTerm, suffix[1])])])

private partial def sameTree (a b : Syntax) : Bool :=
  match a, b with
  | .missing, .missing => true
  | .atom _ x, .atom _ y => x == y
  | .ident _ _ x _, .ident _ _ y _ => x == y
  | .node _ k xs, .node _ j ys =>
      k == j && xs.size == ys.size && (xs.zip ys).all((fun (x, y) => sameTree x y))
  | _, _ => false

private def sameBinders (a b : Array Syntax) : Bool :=
  a.size == b.size && (a.zip b).all((fun (x, y) => sameTree x y))

partial function lowerOne(source : Syntax) : MacroM((Array Syntax)) := withRef(source, do
  if source.isOfKind choiceKind then
    let mut result? := none
    for alternative in source.getArgs do
      let candidate ← lowerOne alternative
      if let some previous := result? then
        unless sameBinders previous candidate do
          Macro.throwError "PS0V1-BINDER-AMBIGUITY: different successful binder partitions"
      else result? := some candidate
    return result?.getD #[]
  if source.isOfKind ``psCommaBinder then
    source[1].getSepArgs.mapM(fun param => withRef(param, do
      let ty ← PS0.Syntax.lower(`psTerm, param[2])
      let suffix ← lowerSuffix(param[3])
      return .node((origin param), ``Lean.Parser.Term.explicitBinder,
        #[mkAtom "(", mkNullNode #[param[0]], mkNullNode #[param[1], ty], suffix, mkAtom ")"])))
  else if source.isOfKind ``psExplicitBinder then
    return #[.node((origin source), ``Lean.Parser.Term.explicitBinder,
      #[source[0], source[1], ← lowerType(source[2]), ← lowerSuffix(source[3]), source[4]])]
  else if source.isOfKind ``psImplicitBinder then
    return #[.node((origin source), ``Lean.Parser.Term.implicitBinder,
      #[source[0], source[1], ← lowerType(source[2]), source[3]])]
  else if source.isOfKind ``psStrictBinder || source.isOfKind ``psAsciiStrictBinder then
    return #[.node((origin source), ``Lean.Parser.Term.strictImplicitBinder,
      #[mkAtom "⦃", source[1], ← lowerType(source[2]), mkAtom "⦄"])]
  else if source.isOfKind ``psInstanceBinder then
    return #[.node((origin source), ``Lean.Parser.Term.instBinder,
      #[source[0], source[1], ← PS0.Syntax.lower(`psTerm, source[2]), source[3]])]
  else if source.isOfKind ``psIdentifierBinder then return #[source[0]]
  else if source.isOfKind ``psNullaryBinder then
    Macro.throwError "PS0V1-BIND-EMPTY: only function's dedicated nullary telescope inserts Unit"
  else Macro.throwError "PS0V1-BINDER-LOWER: unsupported binder")

private partial function aliasKind(source : Syntax) : Nat :=
  if source.isOfKind choiceKind then
    source.getArgs.foldl((fun k alternative => max(k, (aliasKind alternative))), 0)
  else if source.isOfKind ``psCommaBinder then 2
  else if source.isOfKind ``psNullaryBinder then 3
  else if source.isOfKind ``psImplicitBinder || source.isOfKind ``psStrictBinder ||
      source.isOfKind ``psAsciiStrictBinder || source.isOfKind ``psInstanceBinder then 1
  else 0

def lowerTelescope (parts : Array((TSyntax `psDeclBinder))) (alias := false) :
    MacroM((Array((TSyntax ``Lean.Parser.Term.bracketedBinder)))) := do
  let mut result : Array Syntax := #[]
  let mut previousExplicit := false
  let mut seenExplicit := false
  for i in [:parts.size] do
    let part := parts[i]!.raw
    let kind := aliasKind part
    if alias then
      if kind == 0 then
        withRef(part, do Macro.throwError "PS0V1-BIND-ALIAS: function parameters require named typed comma groups")
      if kind == 3 then
        unless i + 1 == parts.size && !seenExplicit do
          withRef(part, do Macro.throwError "PS0V1-BIND-EMPTY: nullary group must be final and have no explicit predecessor")
        let unit ← `(bracketedBinder| (_unit : Unit))
        result := result.push unit.raw
      else
        if kind == 2 && previousExplicit then
          withRef(part, do Macro.throwError "PS0V1-BIND-02: adjacent explicit groups must be joined by commas")
        result := result ++ (← lowerOne part)
      previousExplicit := kind == 2
      seenExplicit := seenExplicit || previousExplicit
    else result := result ++ (← lowerOne part)
  return result.map((⟨·⟩))

end PS0.Binders

syntax (name := ps0LocalCommaBinder) PS0.Binders.psCommaBinder : psLocalBinder

@[macro ps0LocalCommaBinder] const expandLocalCommaBinder : Macro := fun source => do
  return mkNullNode((← PS0.Binders.lowerOne(source[0])))
