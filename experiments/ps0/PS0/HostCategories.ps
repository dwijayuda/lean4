module
prelude
public import Init
public meta import Init
public meta import Lean
public import PS0.Operators
public meta section

/-! PS-owned category adapters; independently owned native and DSL syntax stays opaque. -/

open Lean

declare_syntax_cat psTerm
declare_syntax_cat psCommand
declare_syntax_cat psTactic (behavior := both)
declare_syntax_cat psDoSeq
declare_syntax_cat psCallArg
declare_syntax_cat psHead
declare_syntax_cat psFunBinder
declare_syntax_cat psDoElem
declare_syntax_cat psDoItem
declare_syntax_cat psLocalBinder
declare_syntax_cat psStructInstFieldDecl
declare_syntax_cat psLoopBinder
declare_syntax_cat psDataOperand
declare_syntax_cat psDataTacticOperand
declare_syntax_cat psDataBinder
declare_syntax_cat psMatchPattern

namespace PS0.DoLayout
open Lean.Parser

private function redirect(roles : Array((Name × Name)), ctx : ParserContextCore) : ParserContextCore := Id.run(do
  let native := categoryParserFnExtension.getState ctx.env
  let restore := fun (child : ParserContextCore) => {child with env := categoryParserFnExtension.setState child.env native}
  let dispatch : CategoryParserFn := fun category =>
    match roles.find?((fun role => role.1 == category)) with
    | some (_, target) => adaptUncacheableContextFn(restore, (native target))
    | none => adaptUncacheableContextFn(restore, (native category))
  return {ctx with env := categoryParserFnExtension.setState ctx.env dispatch})

private function operands(roles : Array((Name × Name)), parser : Parser) : Parser :=
  withFn((adaptUncacheableContextFn((redirect roles))), parser)

@[run_parser_attribute_hooks] const sequence : Parser :=
  operands #[(`doElem, `psDoElem)] Lean.Parser.Term.doSeq

@[run_parser_attribute_hooks] const returnElem : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.doReturn

@[run_parser_attribute_hooks] const nestedActionTerm : Parser :=
  operands #[(`doElem, `psDoElem)] Lean.Parser.Term.nestedAction

@[run_parser_attribute_hooks] const returnTerm : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.termReturn

@[run_parser_attribute_hooks] const expressionElem : Parser :=
  -- Both do-expression alternatives read the same PS operand. Enter it directly
  -- so longest-match alternatives can reuse Lean's category cache.
  leadingNode ``Lean.Parser.Term.doExpr leadPrec <|
    Lean.Parser.Term.notFollowedByRedefinedTermToken >> categoryParser `psTerm 0 >>
      notFollowedBy((symbol ":=" <|> Lean.Parser.Term.leftArrow),
        "unexpected token after 'expr' in 'do' block")

@[run_parser_attribute_hooks] const nativeDoOperand : Parser :=
  withFn((fun parse ctx initial =>
    let parsed := parse ctx initial
    if parsed.hasError then parsed
    else if parsed.stxStack.back.isOfKind ``Lean.Parser.Term.doIf then
      initial.mkUnexpectedError "PS0V1-DO-OWNERSHIP: if uses its PS operand adapter"
    else parsed), (categoryParser `doElem 0))

private const letPrefix : Parser :=
  symbol "let " >> optional((symbol "mut ")) >> Lean.Parser.Term.letConfig

@[run_parser_attribute_hooks] const localBinder : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.letIdBinder

@[run_parser_attribute_hooks] const localLhs : Parser :=
  Lean.Parser.Term.letId >> many((ppSpace >> categoryParser `psLocalBinder 0)) >>
    operands #[(`term, `psTerm)] Lean.Parser.Term.optType

@[run_parser_attribute_hooks] const whereFinally : Parser :=
  operands #[(`tactic, `psTactic)] Lean.Parser.Term.whereFinally

@[run_parser_attribute_hooks] const argumentValue : Parser :=
  withoutPosition((withoutForbidden((categoryParser `psTerm 0))))

@[run_parser_attribute_hooks] const forwardTerm : Parser :=
  operands #[(`doElem, `psDoElem)] Lean.Parser.Term.doForward

@[run_parser_attribute_hooks] const ascriptionTerm : Parser :=
  -- These overlapping native grouping productions must share category caches.
  -- Their value callbacks enter PS directly with native position/hygiene rules.
  withCache `PS0.DoLayout.ascriptionTerm <|
    leadingNode ``Lean.Parser.Term.typeAscription maxPrec <|
      Lean.Parser.Term.hygienicLParen >>
        withoutPosition((withoutForbidden((categoryParser `psTerm 0 >> " :" >>
          optional((ppSpace >> categoryParser `psTerm 0)))))) >> ")"

@[run_parser_attribute_hooks] const byTerm : Parser :=
  operands #[(`tactic, `psTactic)] Lean.Parser.Term.byTactic

@[run_parser_attribute_hooks] const loopTypedBinder : Parser :=
  leadingNode ``Lean.Parser.Term.typeAscription maxPrec <|
    Lean.Parser.Term.hygienicLParen >> withoutPosition((withoutForbidden(
      (termParser >> " :" >> optional((ppSpace >> categoryParser `psTerm 0)))))) >> ")"

@[run_parser_attribute_hooks] const loopImplicitBinder : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.funImplicitBinder

@[run_parser_attribute_hooks] const loopStrictBinder : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.funStrictImplicitBinder

@[run_parser_attribute_hooks] const loopInstanceBinder : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.instBinder

const loopBasicFun : Parser :=
  node ``Lean.Parser.Term.basicFun <|
    ppGroup((many1((ppSpace >> categoryParser `psLoopBinder 0)) >>
      operands #[(`term, `psTerm)] Lean.Parser.Term.optType >>
      unicodeSymbol " ↦" " =>" (preserveForPP := true))) >>
      ppSpace >> categoryParser `psTerm 0

@[run_parser_attribute_hooks] const loopInvariant : Parser :=
  node ``Lean.Parser.Term.doLoopInvariant <|
    ppIndent((ppLine >> nonReservedSymbol "invariant" >>
      withForbiddens #["do", "decreasing"] loopBasicFun))

@[run_parser_attribute_hooks] const loopDecreasing : Parser :=
  node ``Lean.Parser.Term.doLoopDecreasing <|
    ppIndent((ppLine >> nonReservedSymbol "decreasing" >>
      withForbidden("do", (atomic loopBasicFun <|> (ppSpace >> categoryParser `psTerm 0)))))

@[run_parser_attribute_hooks] const tupleTerm : Parser :=
  leadingNode ``Lean.Parser.Term.tuple maxPrec <|
    Lean.Parser.Term.hygienicLParen >> optional((withoutPosition((withoutForbidden(
      (categoryParser `psTerm 0 >> ", " >>
        sepBy1( (categoryParser `psTerm 0), ", ", allowTrailingSep := true))))))) >> ")"

@[run_parser_attribute_hooks] const forallTerm : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.«forall»

@[run_parser_attribute_hooks] const listTerm : Parser :=
  leadingNode `«term[_]» maxPrec <|
    "[" >> withoutPosition((sepBy( (categoryParser `psTerm 0), ", ", allowTrailingSep := true))) >> "]"

@[run_parser_attribute_hooks] const arrayTerm : Parser :=
  leadingNode `«term#[_,]» maxPrec <|
    "#[" >> withoutPosition((sepBy( (categoryParser `psTerm 0), ", ", allowTrailingSep := true))) >> "]"

@[run_parser_attribute_hooks] const interpolationTerm : Parser :=
  leadingNode `termS!_ maxPrec <| "s!" >> interpolatedStr((categoryParser `psTerm 0))

@[run_parser_attribute_hooks] const constructorTerm : Parser :=
  leadingNode ``Lean.Parser.Term.anonymousCtor maxPrec <|
    "⟨" >> withoutPosition((withoutForbidden(
      (sepBy( (categoryParser `psTerm 0), ", ", allowTrailingSep := true))))) >> "⟩"

@[run_parser_attribute_hooks] const showTerm : Parser :=
  operands #[(`term, `psTerm), (`tactic, `psTactic)] Lean.Parser.Term.«show»

@[run_parser_attribute_hooks] const sufficesTerm : Parser :=
  operands #[(`term, `psTerm), (`tactic, `psTactic)] Lean.Parser.Term.«suffices»

@[run_parser_attribute_hooks] const patternIfTerm : Parser :=
  leadingNode `termIfLet leadPrec <|
    "if " >> "let " >> termParser >> " := " >> categoryParser `psTerm 0 >>
      " then " >> categoryParser `psTerm 0 >> " else " >> categoryParser `psTerm 0

@[run_parser_attribute_hooks] const patternLetTerm : Parser :=
  leadingNode ``Lean.Parser.Term.«let» leadPrec <|
    withPosition(("let" >> Lean.Parser.Term.letConfig >>
      node(``Lean.Parser.Term.letDecl,
        (node(``Lean.Parser.Term.letPatDecl,
          (atomic((ppSpace >> termParser >> pushNone >>
            operands #[(`term, `psTerm)] Lean.Parser.Term.optType >> " := ")) >>
            categoryParser `psTerm 0)))))) >>
      Lean.Parser.Term.optSemicolon((categoryParser `psTerm 0))

@[run_parser_attribute_hooks] const dependentIfTerm : Parser :=
  leadingNode `termDepIfThenElse leadPrec <|
    ppRealGroup((ppRealFill((ppIndent(("if " >> node `Lean.binderIdent Lean.Parser.Term.binderIdent >> " : " >>
      categoryParser `psTerm 0 >> " then")) >> ppSpace >> categoryParser `psTerm 0)) >>
      ppDedent ppSpace >> ppRealFill(("else " >> categoryParser `psTerm 0))))

-- The positional call adapter emits a native pattern application. In
-- particular an empty application must reach Lean's pattern arity check.
@[run_parser_attribute_hooks] const patternCall : Parser :=
  withFn((fun parse => withResultOfFn(parse, fun source =>
    let info := match source.getRange? with
      | some span => .synthetic span.start span.stop false
      | none => .none
    .node(info, ``Lean.Parser.Term.app, #[source[0], mkNullNode(source[2].getSepArgs)]))),
    (node `PS0.DoLayout.patternCall <|
      (PS0.Operators.adjacentIdentifier <|> Lean.Parser.Term.dotIdent) >>
        checkNoWsBefore >> "(" >>
        withoutPosition((sepBy((categoryParser `psMatchPattern 0), ",", ("," >> ppSpace), true))) >>
        ")"))

private const matchPatternAlternative : Parser :=
  node ``Lean.Parser.Term.matchAlt <|
    "| " >> ppIndent(
      sepBy1((sepBy1((categoryParser `psMatchPattern 0), ", ")), " | ") >>
        Lean.Parser.darrow >>
        checkColGe "alternative right-hand-side to start in a column greater than or equal to the corresponding '|'" >>
        categoryParser `psTerm 0)

private const matchPatternAlternatives : Parser :=
  node ``Lean.Parser.Term.matchAlts <| withPosition(many1Indent(ppLine >> matchPatternAlternative))

@[run_parser_attribute_hooks] const matchTerm : Parser :=
  leadingNode ``Lean.Parser.Term.«match» leadPrec <|
    "match " >> optional Lean.Parser.Term.generalizingParam >>
      optional((operands #[(`term, `psTerm)] Lean.Parser.Term.motive)) >>
      sepBy1((operands #[(`term, `psTerm)] Lean.Parser.Term.matchDiscr), ", ") >>
      " with" >> ppDedent(
        withFn((fun parse => withResultOfFn(parse, fun source => source[1])),
          (node `PS0.DoLayout.bracedAlternatives <| "{" >> matchPatternAlternatives >> "}")) <|>
        matchPatternAlternatives)

@[run_parser_attribute_hooks] const patternLambda : Parser :=
  leadingNode ``Lean.Parser.Term.«fun» maxPrec <|
    ppAllowUngrouped >> unicodeSymbol "λ" "fun" (preserveForPP := true) >>
      Lean.Parser.Term.matchAlts((categoryParser `psTerm 0))

@[run_parser_attribute_hooks] const recordTerm : Parser :=
  withFn((fun parse ctx initial =>
    let parsed := parse ctx initial
    if parsed.hasError then parsed else
      let source := parsed.stxStack.back
      if source.getArgs.size == 6 && source[1].getArgs.isEmpty &&
          source[2].isOfKind(``Lean.Parser.Term.structInstFields) &&
          source[2][0].getArgs.isEmpty && source[4].getArgs.isEmpty &&
          source[3].getArgs.size == 1 && source[3][0].getArgs.isEmpty then
        -- No PS operands occur in `{}`. Preserve the native empty-collection/
        -- structure choice instead of committing to a structure before typing.
        PS0.Operators.leading.fn ctx initial
      else parsed),
    (operands #[(`term, `psTerm), (`structInstFieldDecl, `psStructInstFieldDecl)]
      Lean.Parser.Term.structInst))

@[run_parser_attribute_hooks] const fieldDefinition : Parser :=
  operands #[(`term, `psTerm)] Lean.Parser.Term.structInstFieldDef

@[run_parser_attribute_hooks] const fieldEquations : Parser :=
  node ``Lean.Parser.Term.structInstFieldEqns <|
    optional "private" >> Lean.Parser.Term.matchAlts((categoryParser `psTerm 0))

private const ifCondition : Parser :=
  node(``Lean.Parser.Term.doIfLet,
      ("let " >> termParser >>
        (operands #[(`term, `psTerm)] Lean.Parser.Term.doIfLetPure <|>
         operands #[(`term, `psTerm)] Lean.Parser.Term.doIfLetBind))) <|>
    operands #[(`term, `psTerm)] Lean.Parser.Term.doIfProp

@[run_parser_attribute_hooks] const ifElem : Parser :=
  leadingNode ``Lean.Parser.Term.doIf maxPrec <| withResetCache <|
    withPositionAfterLinebreak <| ppRealGroup <|
      ppRealFill((ppIndent(("if " >> ifCondition >> " then")) >> ppSpace >> sequence)) >>
      many((checkColGe "'else if' in 'do' must be indented" >>
        group((ppDedent ppSpace >> ppRealFill(
          (Lean.Parser.Term.elseIf >> ifCondition >> " then " >> sequence)))))) >>
      optional((checkColGe "'else' in 'do' must be indented" >>
        ppDedent ppSpace >> ppRealFill(("else " >> sequence))))

@[run_parser_attribute_hooks] const whileElem : Parser :=
  leadingNode ``Lean.Parser.Term.doWhile maxPrec <|
    "while " >> withForbiddens #["do", "invariant", "decreasing"] ifCondition >>
      optional loopInvariant >> optional loopDecreasing >>
      " do " >> sequence

@[run_parser_attribute_hooks] const repeatElem : Parser :=
  leadingNode ``Lean.Parser.Term.doRepeatUntil maxPrec <|
    "repeat " >> optional loopInvariant >> optional loopDecreasing >>
      sequence >> ppDedent ppLine >> "until " >> categoryParser `psTerm 0

const namedDeclaration : Parser :=
  node ``Lean.Parser.Term.letDecl <|
    notFollowedBy((nonReservedSymbol "rec"), "rec") >>
      node(``Lean.Parser.Term.letIdDecl,
        (atomic((localLhs >> " := ")) >> categoryParser `psTerm 0))

@[run_parser_attribute_hooks] const letElem : Parser :=
  leadingNode ``Lean.Parser.Term.doLet maxPrec <|
    letPrefix >> namedDeclaration

@[run_parser_attribute_hooks] const haveElem : Parser :=
  leadingNode ``Lean.Parser.Term.doHave maxPrec <|
    "have " >> Lean.Parser.Term.letConfig >> namedDeclaration

@[run_parser_attribute_hooks] const matchElem : Parser :=
  leadingNode ``Lean.Parser.Term.doMatch leadPrec <|
    "match " >> optional Lean.Parser.Term.dependentParam >>
      optional Lean.Parser.Term.generalizingParam >>
      optional((operands #[(`term, `psTerm)] Lean.Parser.Term.motive)) >>
      sepBy1((operands #[(`term, `psTerm)] Lean.Parser.Term.matchDiscr), ", ") >>
      " with" >> ppDedent((Lean.Parser.Term.matchAlts sequence))

const forDeclaration : Parser :=
  node ``Lean.Parser.Term.doForDecl <|
    optional((atomic((ident >> " : ")))) >> termParser >> " in " >>
      withForbiddens(#["do", "invariant", "decreasing"], (categoryParser `psTerm 0))

@[run_parser_attribute_hooks] const forElem : Parser :=
  leadingNode ``Lean.Parser.Term.doFor maxPrec <|
    "for " >> sepBy1 forDeclaration ", " >> optional loopInvariant >>
      optional loopDecreasing >> " do " >> sequence

@[run_parser_attribute_hooks] const forTerm : Parser :=
  leadingNode ``Lean.Parser.Term.termFor leadPrec <|
    "for " >> sepBy1 forDeclaration ", " >> optional loopInvariant >>
      optional loopDecreasing >> " do " >> sequence

const catchElem : Parser :=
  node ``Lean.Parser.Term.doCatch <|
    ppDedent ppLine >> atomic(("catch " >> Lean.Parser.Term.binderIdent)) >>
      optional((" : " >> categoryParser `psTerm 0)) >> darrow >> sequence

const catchMatchElem : Parser :=
  node ``Lean.Parser.Term.doCatchMatch <|
    ppDedent ppLine >> "catch " >> ppDedent((Lean.Parser.Term.matchAlts sequence))

const finallyElem : Parser :=
  node ``Lean.Parser.Term.doFinally <| ppDedent ppLine >> "finally " >> sequence

@[run_parser_attribute_hooks] const tryElem : Parser :=
  leadingNode ``Lean.Parser.Term.doTry maxPrec <|
    "try " >> sequence >> many((catchElem <|> catchMatchElem)) >> optional finallyElem

@[run_parser_attribute_hooks] const tryTerm : Parser :=
  leadingNode ``Lean.Parser.Term.termTry leadPrec <|
    "try " >> sequence >> many((catchElem <|> catchMatchElem)) >> optional finallyElem

@[run_parser_attribute_hooks] const initializeCommand : Parser :=
  leadingNode ``Lean.Parser.Command.«initialize» leadPrec <|
    Lean.Parser.Command.declModifiers false >> Lean.Parser.Command.initializeKeyword >>
      optional((atomic((ident >> operands #[(`term, `psTerm)] Lean.Parser.Term.typeSpec >>
        ppSpace >> Lean.Parser.Term.leftArrow)))) >> sequence

const dataSignature : Parser :=
  node ``Lean.Parser.Command.optDeclSig <|
    withForbiddens(#["given", "requires", "ensures"],
      (many((ppSpace >> (Lean.Parser.Term.binderIdent <|> categoryParser `psDataBinder 0))))) >>
    optional((operands #[(`term, `psDataOperand)] Lean.Parser.Command.defTypeSpec))

const dataRequiredSignature : Parser :=
  node ``Lean.Parser.Command.declSig <|
    many((ppSpace >> (Lean.Parser.Term.binderIdent <|> categoryParser `psDataBinder 0))) >>
      operands #[(`term, `psDataOperand)] Lean.Parser.Term.typeSpec

@[run_parser_attribute_hooks] const dataNativeBinder : Parser :=
  operands #[(`term, `psDataOperand)] Lean.Parser.Term.bracketedBinder

const dataBinderSuffix : Parser :=
  Lean.Parser.Term.binderTactic <|>
    operands #[(`term, `psDataOperand)] Lean.Parser.Term.binderDefault

const dataStructExplicitBinder : Parser :=
  node ``Lean.Parser.Command.structExplicitBinder <|
    atomic((Lean.Parser.Command.declModifiers true >> "(")) >>
      withoutPosition((many1 ident >> ppIndent dataSignature >> optional dataBinderSuffix)) >> ")"

const dataStructImplicitBinder : Parser :=
  node ``Lean.Parser.Command.structImplicitBinder <|
    atomic((Lean.Parser.Command.declModifiers true >> "{")) >>
      withoutPosition((many1 ident >> dataRequiredSignature)) >> "}"

const dataStructInstBinder : Parser :=
  node ``Lean.Parser.Command.structInstBinder <|
    atomic((Lean.Parser.Command.declModifiers true >> "[")) >>
      withoutPosition((many1 ident >> dataRequiredSignature)) >> "]"

const dataStructSimpleBinder : Parser :=
  node ``Lean.Parser.Command.structSimpleBinder <|
    atomic((Lean.Parser.Command.declModifiers true >> ident)) >>
      dataSignature >> optional dataBinderSuffix

const dataStructFields : Parser :=
  node ``Lean.Parser.Command.structFields <|
    manyIndent((ppLine >> checkColGe >> ppGroup(
      (dataStructExplicitBinder <|> dataStructImplicitBinder <|>
        dataStructInstBinder <|> dataStructSimpleBinder))))

const dataStructCtor : Parser :=
  node ``Lean.Parser.Command.structCtor <|
    atomic((ppIndent((Lean.Parser.Command.declModifiers true >> ident >>
      many((ppSpace >> categoryParser `psDataBinder 0)) >> " :: "))))

const dataComputedField : Parser :=
  node ``Lean.Parser.Command.computedField <|
    Lean.Parser.Command.declModifiers true >> ident >> " : " >>
      categoryParser `psDataOperand 0 >> Lean.Parser.Term.matchAlts((categoryParser `psDataOperand 0))

const dataComputedFields : Parser :=
  node ``Lean.Parser.Command.computedFields <|
    "with" >> manyIndent((ppLine >> ppGroup dataComputedField))

const dataConstructor : Parser :=
  node ``Lean.Parser.Command.ctor <|
    atomic((optional Lean.Parser.Command.docComment >> "\n| ")) >>
      ppGroup((Lean.Parser.Command.declModifiers true >> rawIdent >> dataSignature))

private const dataConstructors : Parser :=
  withFn((fun parse => withResultOfFn(parse, fun source => source[1])),
    (node `PS0.DoLayout.bracedConstructors <| "{" >> many dataConstructor >> "}")) <|> many dataConstructor

const dataDeclRecovery : Parser where
  fn := andthenFn(
    (takeUntilFn(fun c => c.isWhitespace || c == '(' || c == ')' || c == ':' || c == '{' || c == '}' || c == '|')),
    (takeWhileFn Char.isWhitespace))

function dataInductive(kind : Name, keyword : String) : Parser :=
  node kind <| symbol keyword >> recover Lean.Parser.Command.declId dataDeclRecovery >>
    ppIndent dataSignature >> optional((symbol " :=" <|> " where")) >> dataConstructors >>
    optional((ppDedent ppLine >> dataComputedFields)) >> Lean.Parser.Command.optDeriving >>
    optional((operands #[(`tactic, `psDataTacticOperand)] Lean.Parser.Command.monotonicityBy))

const dataClassInductive : Parser :=
  node ``Lean.Parser.Command.classInductive <|
    atomic((group((symbol "class " >> "inductive ")))) >>
      recover Lean.Parser.Command.declId dataDeclRecovery >> ppIndent dataSignature >>
      optional((symbol " :=" <|> " where")) >> dataConstructors >> Lean.Parser.Command.optDeriving

const dataExtends : Parser :=
  node ``Lean.Parser.Command.«extends» <|
    " extends " >> sepBy1((operands #[(`term, `psDataOperand)] Lean.Parser.Command.structParent), ", ") >>
      operands #[(`term, `psDataOperand)] Lean.Parser.Term.optType

const dataStructure : Parser :=
  node ``Lean.Parser.Command.«structure» <|
    (Lean.Parser.Command.structureTk <|> Lean.Parser.Command.classTk) >> Lean.Parser.Command.declId >>
      ppIndent((dataSignature >> optional dataExtends)) >>
      optional(((symbol " := " <|> " where ") >>
        optional dataStructCtor >> dataStructFields)) >>
      Lean.Parser.Command.optDeriving

@[run_parser_attribute_hooks] const dataCommand : Parser :=
  leadingNode ``Lean.Parser.Command.declaration leadPrec <|
    Lean.Parser.Command.declModifiers false >>
      (dataInductive ``Lean.Parser.Command.«inductive» "inductive " <|>
       dataInductive ``Lean.Parser.Command.«coinductive» "coinductive " <|>
       dataClassInductive <|> dataStructure)

@[run_parser_attribute_hooks] const namedLetTerm : Parser :=
  leadingNode ``Lean.Parser.Term.«let» leadPrec <|
    withPosition(("let" >> Lean.Parser.Term.letConfig >> namedDeclaration)) >>
      Lean.Parser.Term.optSemicolon((categoryParser `psTerm 0))

@[run_parser_attribute_hooks] const namedHaveTerm : Parser :=
  leadingNode ``Lean.Parser.Term.«have» leadPrec <|
    withPosition(("have" >> Lean.Parser.Term.letConfig >> namedDeclaration)) >>
      Lean.Parser.Term.optSemicolon((categoryParser `psTerm 0))

const recursiveDeclaration : Parser :=
  node ``Lean.Parser.Term.letRecDecl <|
    optional Lean.Parser.Command.docComment >> optional Lean.Parser.Term.attributes >>
    node(``Lean.Parser.Term.letDecl,
      (notFollowedBy((nonReservedSymbol "rec"), "rec") >>
        (node(``Lean.Parser.Term.letIdDecl,
          (atomic((localLhs >> " := ")) >>
            categoryParser `psTerm 0)) <|>
         node(``Lean.Parser.Term.letEqnsDecl,
          (localLhs >>
            Lean.Parser.Term.matchAlts((categoryParser `psTerm 0))))))) >>
    Lean.Parser.Termination.suffix

const recursiveDeclarations : Parser :=
  node ``Lean.Parser.Term.letRecDecls <| sepBy1 recursiveDeclaration ", "

const recursivePrefix : Parser :=
  group((symbol "let " >> nonReservedSymbol "rec "))

@[run_parser_attribute_hooks] const recursiveElem : Parser :=
  leadingNode ``Lean.Parser.Term.doLetRec maxPrec <| recursivePrefix >> recursiveDeclarations

@[run_parser_attribute_hooks] const recursiveTerm : Parser :=
  leadingNode ``Lean.Parser.Term.letrec leadPrec <|
    withPosition((recursivePrefix >> recursiveDeclarations)) >>
      Lean.Parser.Term.optSemicolon((categoryParser `psTerm 0))

@[run_parser_attribute_hooks] const bindElem : Parser :=
  leadingNode ``Lean.Parser.Term.doLetArrow maxPrec <| withPosition <|
    letPrefix >> operands #[(`term, `psTerm), (`doElem, `psDoElem)] Lean.Parser.Term.doIdDecl

@[run_parser_attribute_hooks] const patternBindElem : Parser :=
  operands #[(`doElem, `psDoElem)] Lean.Parser.Term.doLetArrow

@[run_parser_attribute_hooks] const patternLetElseElem : Parser :=
  leadingNode ``Lean.Parser.Term.doLetElse leadPrec <| withPosition <|
    letPrefix >> termParser >> " := " >> categoryParser `psTerm 0 >>
      (checkColGe >> " | " >> operands #[(`doElem, `psDoElem)] Lean.Parser.Term.doSeqIndent) >>
      optional((checkColGe >> operands #[(`doElem, `psDoElem)] Lean.Parser.Term.doSeqIndent))

@[run_parser_attribute_hooks] const reassignElem : Parser :=
  leadingNode ``Lean.Parser.Term.doReassign maxPrec <|
    Lean.Parser.Term.notFollowedByRedefinedTermToken >>
      operands #[(`term, `psTerm)] Lean.Parser.Term.letIdDeclNoBinders

@[run_parser_attribute_hooks] const nestedElem : Parser :=
  operands #[(`doElem, `psDoElem)] Lean.Parser.Term.doNested

@[run_parser_attribute_hooks] const unlessElem : Parser :=
  operands #[(`term, `psTerm), (`doElem, `psDoElem)] Lean.Parser.Term.doUnless

@[run_parser_attribute_hooks] const unlessTerm : Parser :=
  operands #[(`term, `psTerm), (`doElem, `psDoElem)] Lean.Parser.Term.termUnless

private function manyPunningFields(source : Syntax) : Bool := Id.run(do
  unless source.isOfKind ``Lean.Parser.Term.structInst && source.getArgs.size == 6 &&
      source[1].getArgs.isEmpty && source[4].getArgs.isEmpty &&
      source[3].getArgs.size == 1 && source[3][0].getArgs.isEmpty &&
      source[2].isOfKind(``Lean.Parser.Term.structInstFields) do return false
  let fields := source[2][0].getSepArgs
  return fields.size >= 2 && fields.all(fun field =>
    field.isOfKind ``Lean.Parser.Term.structInstField && field.getArgs.size == 2 &&
      field[1].getArgs.isEmpty && field[0].getArgs.size == 2 &&
      field[0][0].isIdent && field[0][1].getArgs.isEmpty))

@[run_parser_attribute_hooks] const punningBraces : Parser :=
  withFn((fun _ ctx initial =>
    let parsed := Lean.Parser.Term.structInst.fn ctx initial
    if parsed.hasError then parsed
    else if manyPunningFields parsed.stxStack.back then PS0.Operators.leading.fn ctx initial
    else initial.mkUnexpectedError "PS0V1-PUNNING-BRACES: expected a native punning field list"),
    Lean.Parser.Term.structInst)

end PS0.DoLayout

