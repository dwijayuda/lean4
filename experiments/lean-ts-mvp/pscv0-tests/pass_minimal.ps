const answer: Nat := 42

function add(x: Nat, y: Nat): Nat := {
  x + y
}

function clock(): Nat := 42

theorem addZero(n: Nat): add(n, 0) = n := by {
  simp [add]
}

theorem pairLaw(P: Prop, Q: Prop, hp: P, hq: Q): P ∧ Q := by {
  constructor
  · exact hp
  · exact hq
}

#check answer
