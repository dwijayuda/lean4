module

prelude
public import Lean.Compiler.LCNF.Basic

public section

namespace Lean.Compiler.LCNF

abbrev Scope := FVarIdSet

class MonadScope (m : Type → Type) where
  getScope : m Scope
  withScope : (Scope → Scope) → m α → m α

export MonadScope (getScope withScope)

abbrev ScopeT (m : Type → Type) := ReaderT Scope m

instance [Monad m] : MonadScope((ScopeT m)) where
  getScope  := read
  withScope := withReader

instance (m n) [MonadLift m n] [MonadFunctor m n] [MonadScope m] : MonadScope n where
  getScope    := liftM (getScope : m _)
  withScope f := monadMap( (withScope f), m := m)

function inScope [MonadScope m] [Monad m] (fvarId : FVarId) : m Bool :=
  return (← getScope).contains(fvarId)

@[inline] function withParams [MonadScope m] [Monad m] (ps : Array((Param pu)), x : m α) : m α :=
  withScope((fun s => ps.foldl( fun s p => s.insert p.fvarId, init := s)), x)

@[inline] function withFVar [MonadScope m] [Monad m] (fvarId : FVarId, x : m α) : m α :=
  withScope((fun s => s.insert fvarId), x)

@[inline] function withNewScope [MonadScope m] [Monad m] (x : m α) : m α := do
  withScope((fun _ => {}), x)

end Lean.Compiler.LCNF
