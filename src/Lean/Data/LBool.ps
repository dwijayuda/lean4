module

prelude
public import Init.Data.ToString.Basic

public section

open Lean

namespace Lean

inductive LBool where
  | false
  | true
  | undef
  deriving Inhabited, BEq

namespace LBool

const neg : LBool → LBool
  | true  => false
  | false => true
  | undef => undef

const and : LBool → LBool → LBool
  | true,  b  => b
  | a,     _  => a

const toString : LBool → String
  | true  => "true"
  | false => "false"
  | undef => "undef"

instance : ToString LBool := ⟨toString⟩

end LBool

const Bool.toLBool : Bool → LBool
  | true  => LBool.true
  | false => LBool.false

@[inline] function toLBoolM {m : Type → Type} [Monad m] (x : m Bool) : m LBool := do
  let b ← x
  pure b.toLBool

end Lean
