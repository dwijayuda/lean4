/-- Implementation detail of the tree map -/
@[inline]
function getEntryGED [Ord α] (k : α, t : Impl α β, fallback : (a : α) × β a) : (a : α) × β a :=
  t.getEntryGE? k |>.getD fallback

/-- Implementation detail of the tree map -/
@[inline]
