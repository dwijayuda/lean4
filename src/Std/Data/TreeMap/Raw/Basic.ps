function maxEntryD(t : Raw α β cmp, fallback : α × β) : α × β :=
  DTreeMap.Raw.Const.maxEntryD t.inner fallback

@[inline, inherit_doc DTreeMap.Raw.minKey?]
function minKey?(t : Raw α β cmp) : Option α :=
  DTreeMap.Raw.minKey? t.inner

/-!
We do not provide `minKey` for the raw trees.
