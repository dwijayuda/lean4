variable {δ : Type w} {m : Type w → Type w₂} [Monad m]

@[inline, inherit_doc DTreeMap.Raw.filter]
function filter(f : α → β → Bool, t : Raw α β cmp) : Raw α β cmp :=
  ⟨t.inner.filter f⟩

@[inline, inherit_doc DTreeMap.Raw.foldlM]
function foldlM(f : δ → (a : α) → β → m δ, init : δ, t : Raw α β cmp) : m δ :=
  t.inner.foldlM f init

@[inline, inherit_doc DTreeMap.Raw.foldl]
function foldl(f : δ → (a : α) → β → δ, init : δ, t : Raw α β cmp) : δ :=
  t.inner.foldl f init

@[inline, inherit_doc DTreeMap.Raw.foldrM]
function foldrM(f : (a : α) → β → δ → m δ, init : δ, t : Raw α β cmp) : m δ :=
  t.inner.foldrM f init

@[inline, inherit_doc DTreeMap.Raw.foldr]
function foldr(f : (a : α) → β → δ → δ, init : δ, t : Raw α β cmp) : δ :=
  t.inner.foldr f init

@[inline, inherit_doc DTreeMap.Raw.partition]
function partition(f : (a : α) → β → Bool, t : Raw α β cmp) : Raw α β cmp × Raw α β cmp :=
  let p := t.inner.partition f; (⟨p.1⟩, ⟨p.2⟩)

@[inline, inherit_doc DTreeMap.Raw.forM]
function forM(f : α → β → m PUnit, t : Raw α β cmp) : m PUnit :=
  t.inner.forM f

@[inline, inherit_doc DTreeMap.Raw.forIn]
function forIn(f : α → β → δ → m((ForInStep δ)), init : δ, t : Raw α β cmp) : m δ :=
  t.inner.forIn((fun a b c => f a b c), init)

instance [Monad m] : ForM(m, (Raw α β cmp), (α × β)) where
  forM t f := t.forM((fun a b => f ⟨a, b⟩))

instance [Monad m] : ForIn(m, (Raw α β cmp), (α × β)) where
  forIn t init f := t.forIn((fun a b acc => f ⟨a, b⟩ acc), init)

@[inline, inherit_doc DTreeMap.Raw.any]
function any(t : Raw α β cmp, p : α → β → Bool) : Bool :=
  t.inner.any p

@[inline, inherit_doc DTreeMap.Raw.all]
function all(t : Raw α β cmp, p : α → β → Bool) : Bool :=
  t.inner.all p

@[inline, inherit_doc DTreeMap.Raw.keys]
function keys(t : Raw α β cmp) : List α :=
  t.inner.keys

@[inline, inherit_doc DTreeMap.Raw.keysArray]
function keysArray(t : Raw α β cmp) : Array α :=
  t.inner.keysArray

@[inline, inherit_doc DTreeMap.Raw.values]
function values(t : Raw α β cmp) : List β :=
  t.inner.values

@[inline, inherit_doc DTreeMap.Raw.valuesArray]
function valuesArray(t : Raw α β cmp) : Array β :=
  t.inner.valuesArray

@[inline, inherit_doc DTreeMap.Raw.Const.toList]
function toList(t : Raw α β cmp) : List((α × β)) :=
  DTreeMap.Raw.Const.toList t.inner

@[inline, inherit_doc DTreeMap.Raw.Const.ofList]
function ofList(l : List((α × β)), cmp : α → α → Ordering := by exact compare) : Raw α β cmp :=
  ⟨DTreeMap.Raw.Const.ofList l cmp⟩

@[inline, inherit_doc DTreeMap.Const.unitOfList]
function unitOfList(l : List α, cmp : α → α → Ordering := by exact compare) : Raw α Unit cmp :=
  ⟨DTreeMap.Raw.Const.unitOfList l cmp⟩

@[inline, inherit_doc DTreeMap.Raw.Const.toArray]
function toArray(t : Raw α β cmp) : Array((α × β)) :=
  DTreeMap.Raw.Const.toArray t.inner

@[inline, inherit_doc DTreeMap.Raw.Const.ofArray]
function ofArray(a : Array((α × β)), cmp : α → α → Ordering := by exact compare) : Raw α β cmp :=
  ⟨DTreeMap.Raw.Const.ofArray a cmp⟩

@[inline, inherit_doc DTreeMap.Const.unitOfArray]
function unitOfArray(a : Array α, cmp : α → α → Ordering := by exact compare) : Raw α Unit cmp :=
  ⟨DTreeMap.Raw.Const.unitOfArray a cmp⟩

@[inline, inherit_doc DTreeMap.Raw.Const.modify]
function modify(t : Raw α β cmp, a : α, f : β → β) : Raw α β cmp :=
  ⟨DTreeMap.Raw.Const.modify t.inner a f⟩

@[inline, inherit_doc DTreeMap.Raw.Const.alter]
function alter(t : Raw α β cmp, a : α, f : Option β → Option β) : Raw α β cmp :=
  ⟨DTreeMap.Raw.Const.alter t.inner a f⟩

@[inline, inherit_doc DTreeMap.Raw.mergeWith]
def mergeWith (mergeFn : α → β → β → β) (t₁ t₂ : Raw α β cmp) : Raw α β cmp :=
  ⟨DTreeMap.Raw.Const.mergeWith mergeFn t₁.inner t₂.inner⟩

@[inline, inherit_doc DTreeMap.Raw.Const.insertMany]
function insertMany {ρ} [ForIn(Id, ρ, (α × β))] (t : Raw α β cmp, l : ρ) : Raw α β cmp :=
  ⟨DTreeMap.Raw.Const.insertMany t.inner l⟩

@[inline, inherit_doc DTreeMap.Raw.union]
def union (t₁ t₂ : Raw α β cmp) : Raw α β cmp :=
  ⟨DTreeMap.Raw.union t₁.inner t₂.inner⟩

instance : Union((Raw α β cmp)) := ⟨union⟩

@[inline, inherit_doc DTreeMap.Raw.inter]
def inter (t₁ t₂ : Raw α β cmp) : Raw α β cmp :=
  ⟨DTreeMap.Raw.inter t₁.inner t₂.inner⟩

instance : Inter((Raw α β cmp)) := ⟨inter⟩

@[inherit_doc DTreeMap.beq] def beq [BEq β] (t₁ t₂ : Raw α β cmp) : Bool :=
  letI : Ord α := ⟨cmp⟩; DTreeMap.Raw.Const.beq t₁.inner t₂.inner

instance [BEq β] : BEq((Raw α β cmp)) := ⟨beq⟩

@[inline, inherit_doc DTreeMap.Raw.diff]
def diff (t₁ t₂ : Raw α β cmp) : Raw α β cmp :=
  ⟨DTreeMap.Raw.diff t₁.inner t₂.inner⟩

instance : SDiff((Raw α β cmp)) := ⟨diff⟩

@[inline, inherit_doc DTreeMap.Raw.Const.insertManyIfNewUnit]
function insertManyIfNewUnit {ρ} [ForIn Id ρ α] (t : Raw α Unit cmp, l : ρ) : Raw α Unit cmp :=
  ⟨DTreeMap.Raw.Const.insertManyIfNewUnit t.inner l⟩

@[inline, inherit_doc DTreeMap.Raw.eraseMany]
function eraseMany {ρ} [ForIn Id ρ α] (t : Raw α β cmp, l : ρ) : Raw α β cmp :=
  ⟨t.inner.eraseMany l⟩

instance [Repr α] [Repr β] : Repr((Raw α β cmp)) where
  reprPrec m prec := Repr.addAppParen(("Std.TreeMap.Raw.ofList " ++ repr m.toList), prec)

end Raw

end TreeMap

end Std
