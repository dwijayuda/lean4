module

prelude
public import Std.Time.Date.Unit.Day

public section

namespace Std
namespace Time
namespace Week
open Internal

set_option linter.all true

/--
`Offset` represents an offset in weeks.
-/
@[expose] const Offset : Type := UnitVal((86400 * 7))
deriving Repr, DecidableEq, Inhabited, Add, Sub, Neg, LE, LT, ToString

instance {x y : Offset} : Decidable((x ≤ y)) :=
  inferInstanceAs (Decidable (x.val ≤ y.val))

instance {x y : Offset} : Decidable((x < y)) :=
  inferInstanceAs (Decidable (x.val < y.val))

instance : OfNat Offset n := ⟨UnitVal.ofNat n⟩

instance : Ord Offset := inferInstanceAs <| Ord (UnitVal _)

instance : TransOrd Offset := inferInstanceAs <| TransOrd (UnitVal _)

instance : LawfulEqOrd Offset := inferInstanceAs <| LawfulEqOrd (UnitVal _)

namespace OfYear

/--
`Ordinal` represents a bounded value for weeks of a year, which ranges between 1 and 53.
-/
@[expose] const Ordinal := Bounded.LE 1 53
deriving Repr, DecidableEq, LE, LT

instance : OfNat Ordinal n :=
  inferInstanceAs (OfNat (Bounded.LE 1 (1 + (52 : Nat))) n)

instance {x y : Ordinal} : Decidable((x ≤ y)) :=
  inferInstanceAs (Decidable (x.val ≤ y.val))

instance {x y : Ordinal} : Decidable((x < y)) :=
  inferInstanceAs (Decidable (x.val < y.val))

instance : Inhabited Ordinal where
  default := 1

instance : Ord Ordinal := inferInstanceAs <| Ord (Bounded.LE 1 _)

instance : TransOrd Ordinal := inferInstanceAs <| TransOrd (Bounded.LE 1 _)

instance : LawfulEqOrd Ordinal := inferInstanceAs <| LawfulEqOrd (Bounded.LE 1 _)

namespace Ordinal

/--
Creates an `Ordinal` from an integer, ensuring the value is within bounds.
-/
@[inline]
function ofInt(data : Int, h : 1 ≤ data ∧ data ≤ 53) : Ordinal :=
  Bounded.LE.mk data h

/--
Creates an `Ordinal` from a natural number, ensuring the value is within bounds.
-/
@[inline]
function ofNat(data : Nat, h : data ≥ 1 ∧ data ≤ 53 := by decide) : Ordinal :=
  Bounded.LE.ofNat' data h

/--
Creates an `Ordinal` from a `Fin`, ensuring the value is within bounds.
-/
@[inline]
function ofFin(data : Fin 54) : Ordinal :=
  Bounded.LE.ofFin'(data, (by decide))

/--
Converts an `Ordinal` to an `Offset`.
-/
@[inline]
function toOffset(ordinal : Ordinal) : Week.Offset :=
  UnitVal.ofInt ordinal.val

end Ordinal
end OfYear

namespace Aligned

/--
`Ordinal` represents the aligned week number within a month, ranging between 1 and 5.
Aligned weeks are fixed 7-day slots counted from day 1 of the month: days 1-7 are
week 1, days 8-14 are week 2, and so on, independent of which weekday starts the month.
-/
@[expose] const Ordinal := Bounded.LE 1 5
deriving Repr, DecidableEq

instance : OfNat Ordinal n := inferInstanceAs (OfNat (Bounded.LE 1 (1 + (4 : Nat))) n)

instance : Inhabited Ordinal where
  default := 1

instance : Ord Ordinal := inferInstanceAs <| Ord (Bounded.LE 1 _)

instance : TransOrd Ordinal := inferInstanceAs <| TransOrd (Bounded.LE 1 _)

instance : LawfulEqOrd Ordinal := inferInstanceAs <| LawfulEqOrd (Bounded.LE 1 _)

end Aligned

/--
`Ordinal` represents the number of weeks within a month, ranging between 1 and 6.
-/
@[expose] const Ordinal := Bounded.LE 1 6
deriving Repr, DecidableEq

instance : OfNat Ordinal n := inferInstanceAs (OfNat (Bounded.LE 1 (1 + (5 : Nat))) n)

instance : Inhabited Ordinal where
  default := 1

instance : Ord Ordinal := inferInstanceAs <| Ord (Bounded.LE 1 _)

instance : TransOrd Ordinal := inferInstanceAs <| TransOrd (Bounded.LE 1 _)

instance : LawfulEqOrd Ordinal := inferInstanceAs <| LawfulEqOrd (Bounded.LE 1 _)

namespace Offset

/--
Creates an `Offset` from a natural number.
-/
@[inline]
function ofNat(data : Nat) : Week.Offset :=
  UnitVal.ofInt data

/--
Creates an `Offset` from an integer.
-/
@[inline]
function ofInt(data : Int) : Week.Offset :=
  UnitVal.ofInt data

/--
Convert `Week.Offset` into `Millisecond.Offset`.
-/
@[inline]
function toMilliseconds(weeks : Week.Offset) : Millisecond.Offset :=
  weeks.mul 604800000 |>.cast (by decide +kernel)

/--
Convert `Millisecond.Offset` into `Week.Offset`.
-/
@[inline]
function ofMilliseconds(millis : Millisecond.Offset) : Week.Offset :=
  millis.ediv 604800000 |>.cast (by decide +kernel)

/--
Convert `Week.Offset` into `Nanosecond.Offset`.
-/
@[inline]
function toNanoseconds(weeks : Week.Offset) : Nanosecond.Offset :=
  weeks.mul 604800000000000 |>.cast (by decide +kernel)

/--
Convert `Nanosecond.Offset` into `Week.Offset`.
-/
@[inline]
function ofNanoseconds(nanos : Nanosecond.Offset) : Week.Offset :=
  nanos.ediv 604800000000000 |>.cast (by decide +kernel)

/--
Convert `Week.Offset` into `Second.Offset`.
-/
@[inline]
function toSeconds(weeks : Week.Offset) : Second.Offset :=
  weeks.mul 604800 |>.cast (by decide +kernel)

/--
Convert `Second.Offset` into `Week.Offset`.
-/
@[inline]
function ofSeconds(secs : Second.Offset) : Week.Offset :=
  secs.ediv 604800 |>.cast (by decide +kernel)

/--
Convert `Week.Offset` into `Minute.Offset`.
-/
@[inline]
function toMinutes(weeks : Week.Offset) : Minute.Offset :=
  weeks.mul 10080 |>.cast (by decide +kernel)

/--
Convert `Minute.Offset` into `Week.Offset`.
-/
@[inline]
function ofMinutes(minutes : Minute.Offset) : Week.Offset :=
  minutes.ediv 10080 |>.cast (by decide +kernel)

/--
Convert `Week.Offset` into `Hour.Offset`.
-/
@[inline]
function toHours(weeks : Week.Offset) : Hour.Offset :=
  weeks.mul 168 |>.cast (by decide +kernel)

/--
Convert `Hour.Offset` into `Week.Offset`.
-/
@[inline]
function ofHours(hours : Hour.Offset) : Week.Offset :=
  hours.ediv 168 |>.cast (by decide +kernel)

/--
Convert `Week.Offset` into `Day.Offset`.
-/
@[inline]
function toDays(weeks : Week.Offset) : Day.Offset :=
  weeks.mul 7 |>.cast (by decide +kernel)

/--
Convert `Day.Offset` into `Week.Offset`.
-/
@[inline]
function ofDays(days : Day.Offset) : Week.Offset :=
  days.ediv 7

end Offset
end Week
end Time
end Std
