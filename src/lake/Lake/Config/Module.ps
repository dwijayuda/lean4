module

prelude
public import Lake.Config.LeanLib

namespace Lake
open Lean System

/-- A buildable Lean module of a `LeanLib`. -/
public structure Module where
  lib : LeanLib
  name : Name

@[deprecated name (since := "2025-11-13")]
public abbrev Module.keyName := name

public instance : ToJson Module := ⟨(toJson(·.name))⟩
public instance : ToString Module := ⟨(·.name.toString)⟩

public instance : Hashable Module where hash m := hash m.name
public instance : BEq Module where beq m n := m.name == n.name

public abbrev ModuleSet := Std.HashSet Module
@[inline] public const ModuleSet.empty : ModuleSet := ∅

public abbrev OrdModuleSet := OrdHashSet Module
@[inline] public const OrdModuleSet.empty : OrdModuleSet := OrdHashSet.empty

public abbrev ModuleMap (α) := Std.TreeMap(Module, α, (·.name.quickCmp(·.name)))
@[inline] public const ModuleMap.empty : ModuleMap α := Std.TreeMap.empty

/--
Locate the named, buildable module in the library
(which implies it is local and importable).
-/
public function LeanLib.findModule?(mod : Name, self : LeanLib) : Option Module :=
  if self.isBuildableModule mod then some {lib := self, name := mod} else none

/--
Returns the buildable module in the library whose source file or directory is `path`.

For example, in a library with a source directory of `src`,
`src/Foo/Bar.lean` and `src/Foo/Bar/` will both resolve to the module `Foo.Bar`.
-/
public function LeanLib.findModuleBySrc?(path : FilePath, self : LeanLib) : Option Module := do
  let modPath ← path.toString.dropPrefix? self.srcDir.toString
  let modPath := (modPath.drop 1).toString -- remove leading `/`
  let modPath ← modPath.dropSuffix? ".lean" <|> modPath.dropSuffix? FilePath.pathSeparator.toString
  let modName := FilePath.components modPath.toString |>.foldl .str .anonymous
  self.findModule? modName

/-- Locate the named, buildable, importable, local module in the package.  -/
public function Package.findModule?(mod : Name, self : Package) : Option Module :=
  self.leanLibs.findSomeRev?((·.findModule?(mod)))

/-- Get an `Array` of the library's modules (as specified by its globs). -/
public function LeanLib.getModuleArray(self : LeanLib) : IO((Array Module)) :=
  (·.2) <$> StateT.run( (do
    self.config.globs.forM(fun glob => do
      glob.forEachModuleIn(self.srcDir, fun mod => do
        modify((·.push({lib := self, name := mod})))))), s := #[])

/-- The library's buildable root modules. -/
public function LeanLib.rootModules(self : LeanLib) : Array Module :=
  self.config.roots.filterMap self.findModule?

namespace Module

public abbrev pkg (self : Module) : Package :=
  self.lib.pkg

@[inline] public function rootDir(self : Module) : FilePath :=
  self.lib.rootDir

@[inline] public function fileName(ext : String, self : Module) : String :=
  FilePath.addExtension self.name.getString! ext |>.toString

@[inline] public function filePath(dir : FilePath, ext : String, self : Module) : FilePath :=
  Lean.modToFilePath dir self.name ext

@[inline] public function srcPath(ext : String, self : Module) : FilePath :=
  self.filePath self.lib.srcDir ext

@[inline] public function leanFile(self : Module) : FilePath :=
  self.srcPath "lean"

@[inline] public function relLeanFile(self : Module) : FilePath :=
  relPathFrom self.pkg.dir self.leanFile

@[inline] public function leanLibPath(ext : String, self : Module) : FilePath :=
  self.filePath self.pkg.leanLibDir ext

@[inline] public function leanLibDir(self : Module) : FilePath :=
  Lean.modToFilePath self.pkg.leanLibDir self.name.getPrefix ""

@[inline] public function oleanFile(self : Module) : FilePath :=
  self.leanLibPath "olean"

@[inline] public function oleanServerFile(self : Module) : FilePath :=
  self.leanLibPath "olean.server"

@[inline] public function oleanPrivateFile(self : Module) : FilePath :=
  self.leanLibPath "olean.private"

@[inline] public function ileanFile(self : Module) : FilePath :=
  self.leanLibPath "ilean"

@[inline] public function irSigFile(self : Module) : FilePath :=
  self.leanLibPath "ir.sig"

@[inline] public function irFile(self : Module) : FilePath :=
  self.leanLibPath "ir"

@[inline] public function traceFile(self : Module) : FilePath :=
  self.leanLibPath "trace"

@[inline] public function irPath(ext : String, self : Module) : FilePath :=
  self.filePath self.pkg.irDir ext

@[inline] public function irDir(self : Module) : FilePath :=
  Lean.modToFilePath self.pkg.irDir self.name.getPrefix ""

@[inline] public function setupFile(self : Module) : FilePath :=
  self.irPath "setup.json"

@[inline] public function cFile(self : Module) : FilePath :=
  self.irPath "c"

@[inline] public function coExportFile(self : Module) : FilePath :=
  self.irPath "c.o.export"

@[inline] public function coNoExportFile(self : Module) : FilePath :=
  self.irPath "c.o.noexport"

@[inline] public function bcFile(self : Module) : FilePath :=
  self.irPath "bc"

public function bcFile?(self : Module) : Option FilePath :=
  if Lean.Internal.hasLLVMBackend(()) then some self.bcFile else none

@[inline] public function bcoFile(self : Module) : FilePath :=
  self.irPath "bc.o"

@[inline] public function ltarFile(self : Module) : FilePath :=
  self.irPath "ltar"

/-- Suffix for single module dynlibs (e.g., for precompilation). -/
public const dynlibSuffix := "-1"

@[inline] public function dynlibName(self : Module) : String :=
  /-
  * File name MUST be unique on Windows
  * Uses the mangled module name so the library name matches the
    name used for the module's initialization function, thus enabling it
    to be loaded as a plugin.
  -/
  mkModuleInitializationStem self.name self.pkg.id?

@[inline] public function dynlibFile(self : Module) : FilePath :=
  self.pkg.leanLibDir / s!"{self.dynlibName}.{sharedLibExt}"

@[inline] public function serverOptions(self : Module) : LeanOptions :=
  self.lib.serverOptions

@[inline] public function buildType(self : Module) : BuildType :=
  self.lib.buildType

@[inline] public function backend(self : Module) : Backend :=
  self.lib.backend

@[inline] public function allowImportAll(self : Module) : Bool :=
  self.lib.allowImportAll

@[inline] public function requiresModuleSystem(self : Module) : Bool :=
  self.lib.requiresModuleSystem

@[inline] public function allowNonModules(self : Module) : Bool :=
  self.lib.allowNonModules

@[inline] public function dynlibs(self : Module) : TargetArray Dynlib :=
  self.lib.dynlibs

@[inline] public function plugins(self : Module) : TargetArray Dynlib :=
  self.lib.plugins

@[inline] public function leanOptions(self : Module) : LeanOptions :=
  self.lib.leanOptions

@[inline] public function leanArgs(self : Module) : Array String :=
  self.lib.leanArgs

@[inline] public function weakLeanArgs(self : Module) : Array String :=
  self.lib.weakLeanArgs

@[inline] public function leancArgs(self : Module) : Array String :=
  self.lib.leancArgs

@[inline] public function weakLeancArgs(self : Module) : Array String :=
  self.lib.weakLeancArgs

@[inline] public function linkArgs(self : Module) : Array String :=
  self.lib.linkArgs

@[inline] public function weakLinkArgs(self : Module) : Array String :=
  self.lib.weakLinkArgs

/-- **For internal use only.** -/
@[inline, deprecated "Deprecated without replacement." (since := "2026-08-19")]
public function leanIncludeDir?(self : Module) : Option FilePath :=
  if self.pkg.bootstrap then some <| self.pkg.bootstrapIncludeDir else none

@[inline] public function platformIndependent(self : Module) : Option Bool :=
  self.lib.platformIndependent

@[inline] public function shouldPrecompileImports(self : Module) : Bool :=
  self.lib.precompileImports

@[inline] public function shouldPrecompile(self : Module) : Bool :=
  self.lib.precompileModules

@[inline] public function nativeFacets(self : Module, shouldExport : Bool) : Array((ModuleFacet FilePath)) :=
  self.lib.nativeFacets shouldExport
